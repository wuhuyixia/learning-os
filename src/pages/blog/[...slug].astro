---
import { type CollectionEntry, getCollection, render } from "astro:content";
import License from "@components/widgets/License.astro";
import PostFilter from "@components/widgets/PostFilter.astro";
import PostInfo from "@components/widgets/PostInfo.astro";
import PostNavigation from "@components/widgets/PostNavigation.astro";
import StackMemoryDemo from "@components/StackMemoryDemo.astro";
import HeapMemoryDemo from "@components/HeapMemoryDemo.astro";
import StackHeapPointerDemo from "@components/StackHeapPointerDemo.astro";
import HeapFitAutoDemo from "@components/HeapFitAutoDemo.astro";
import PointerFunctionAutoDemo from "@components/PointerFunctionAutoDemo.astro";
import { DATE_FORMAT } from "@config";
import BaseLayout from "@layouts/BaseLayout.astro";
import dayjs from "@utils/dayjs";
import MainCard from "@/components/MainCard.astro";
import "katex/dist/katex.min.css";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  const filteredPosts = import.meta.env.PROD
    ? posts.filter((post: CollectionEntry<"blog">) => !post.data.draft)
    : posts;

  return filteredPosts.map((blog: CollectionEntry<"blog">) => ({
    params: { slug: blog.id },
    props: { blog },
  }));
}

interface Props {
  blog: CollectionEntry<"blog">;
}

const { blog } = Astro.props;
const { Content, remarkPluginFrontmatter, headings } = await render(blog);
const displayDate = blog.data.pubDate
  ? dayjs(blog.data.pubDate).format(DATE_FORMAT)
  : "";
const image = new URL(`/learning-os/og/${blog.id}.png`, Astro.site).toString();
const url = new URL(`/learning-os/blog/${blog.id}`, Astro.site ?? Astro.url.origin);
const showStackDemo = blog.data.demo === "stack-memory" || blog.data.demo === "stack-and-heap";
const showHeapDemo = blog.data.demo === "heap-memory" || blog.data.demo === "stack-and-heap";
const showPointerDemo = blog.data.demo === "stack-and-heap";
const showHeapFitAutoDemo = blog.data.demo === "stack-and-heap";
const showPointerFunctionDemo = blog.data.demo === "pointer-function";

const allPosts = await getCollection("blog");
const visiblePosts = (import.meta.env.PROD
  ? allPosts.filter((post: CollectionEntry<"blog">) => !post.data.draft)
  : allPosts
).sort(
  (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
    new Date(a.data.pubDate).getTime() - new Date(b.data.pubDate).getTime(),
);
const currentIndex = visiblePosts.findIndex((post) => post.id === blog.id);
const previousPost = currentIndex > 0 ? visiblePosts[currentIndex - 1] : null;
const nextPost =
  currentIndex >= 0 && currentIndex < visiblePosts.length - 1
    ? visiblePosts[currentIndex + 1]
    : null;
---

<BaseLayout
  title={blog.data.title}
  description={blog.data.description}
  image={image}
  headings={headings}
  showTOC={true}
  ogType="article"
  pubDate={blog.data.pubDate}
>
  <MainCard
    title={blog.data.title}
    description={blog.data.description}
    image={blog.data.image}
    imageFit={blog.data.imageFit}
    infoIcon="lucide:info"
  >
    <PostInfo
      pubDate={displayDate}
      badge={blog.data.badge}
      word={remarkPluginFrontmatter.totalCharCount}
      time={remarkPluginFrontmatter.readingTime}
    />

    <div class="mb-6">
      <PostFilter categories={blog.data.categories} tags={blog.data.tags} />
    </div>

    <div class="mt-8">
      <div id="content" class="prose max-w-none prose-headings:scroll-mt-20 prose-img:rounded-xl prose-img:mx-auto">
        {showStackDemo && (
          <section class="not-prose mb-10">
            <div class="mb-3">
              <h2 class="text-2xl font-bold">1. 栈（Stack）交互演示</h2>
              <p class="mt-2 text-sm opacity-70">观察局部变量、函数调用、返回地址、SP 与递归栈溢出的变化。</p>
            </div>
            <StackMemoryDemo />
          </section>
        )}

        {showHeapDemo && (
          <section class="not-prose mb-10">
            <div class="mb-3">
              <h2 class="text-2xl font-bold">2. 堆（Heap）交互演示</h2>
              <p class="mt-2 text-sm opacity-70">观察 malloc / free、first-fit 分配、外部碎片以及“总空闲够但连续空间不足”的分配失败。</p>
            </div>
            <HeapMemoryDemo />
          </section>
        )}

        {showPointerDemo && (
          <section class="not-prose mb-10">
            <div class="mb-3">
              <h2 class="text-2xl font-bold">3. 栈指针与堆数据</h2>
              <p class="mt-2 text-sm opacity-70">观察栈中的指针变量如何保存地址，并通过箭头指向堆中真正的数据块。</p>
            </div>
            <StackHeapPointerDemo />
          </section>
        )}

        {showHeapFitAutoDemo && (
          <section class="not-prose mb-10">
            <div class="mb-3">
              <h2 class="text-2xl font-bold">4. 堆的常见分配策略</h2>
              <p class="mt-2 text-sm opacity-70">三种策略使用相同初始空闲块和相同请求序列自动循环播放，不需要点击即可直接对比。</p>
            </div>
            <HeapFitAutoDemo />
          </section>
        )}

        {showPointerFunctionDemo && (
          <section class="not-prose mb-10">
            <PointerFunctionAutoDemo />
          </section>
        )}

        <Content />
        <License
          url={url}
          title={blog.data.title}
          image={blog.data.image}
          pubDate={blog.data.pubDate}
          badge={blog.data.badge}
          categories={blog.data.categories}
          tags={blog.data.tags}
          word={remarkPluginFrontmatter.totalCharCount}
          time={remarkPluginFrontmatter.readingTime}
        />
        <PostNavigation
          previous={previousPost ? { id: previousPost.id, title: previousPost.data.title } : null}
          next={nextPost ? { id: nextPost.id, title: nextPost.data.title } : null}
        />
      </div>
    </div>
  </MainCard>
</BaseLayout>
