---
const heapSize = 16;
const indexes = Array.from({ length: heapSize }, (_, index) => index);
const heapCode = [
  "void heap_demo(void)",
  "{",
  "    int *p = malloc(4);",
  "    int *q = malloc(4);",
  "    int *r = malloc(2);",
  "    free(q);",
  "    int *s = malloc(3);",
  "    int *t = malloc(2);",
  "    free(r);",
  "    int *u = malloc(1);",
  "    int *v = malloc(5);",
  "}",
];
---

<section class="heap-memory-demo not-prose" data-heap-memory-demo>
  <div class="heap-memory-demo__header">
    <div>
      <h3>堆内存分配与碎片化演示</h3>
      <p>通过 first-fit（首次适配）观察 malloc / free 如何改变堆布局，并理解外部碎片和分配失败。</p>
    </div>
    <div class="heap-memory-demo__legend">
      <span><i class="heap-memory-demo__dot heap-memory-demo__dot--used"></i>已分配</span>
      <span><i class="heap-memory-demo__dot heap-memory-demo__dot--free"></i>空闲</span>
      <span><i class="heap-memory-demo__dot heap-memory-demo__dot--active"></i>当前执行</span>
    </div>
  </div>

  <div class="heap-memory-demo__controls">
    <button type="button" data-action="prev">上一步</button>
    <button type="button" data-action="next">下一步</button>
    <button type="button" data-action="play">自动播放</button>
    <button type="button" data-action="reset">重置</button>
    <span class="heap-memory-demo__counter">步骤 <strong data-step-index>1</strong> / <span data-step-total>1</span></span>
  </div>

  <div class="heap-memory-demo__summary">
    <div><span>当前动作</span><strong data-step-title>初始状态</strong></div>
    <div><span>已用块</span><strong data-used>0 / 16</strong></div>
    <div><span>总空闲 / 最大连续空闲</span><strong data-free-info>16 / 16</strong></div>
    <div><span>返回指针</span><strong data-pointer-value>NULL</strong></div>
  </div>

  <div class="heap-memory-demo__workspace">
    <div class="heap-memory-demo__code-side">
      <div class="heap-memory-demo__code-panel">
        <div class="heap-memory-demo__code-title">C 代码执行过程</div>
        <ol class="heap-memory-demo__code-list">
          {heapCode.map((line, index) => (
            <li class="heap-memory-demo__code-line" data-code-line={String(index)}>{line}</li>
          ))}
        </ol>
      </div>

      <div class="heap-memory-demo__explain" data-explanation>
        初始时 16 个演示堆块全部空闲。malloc 会寻找足够大的连续空闲区域。
      </div>

      <div class="heap-memory-demo__alloc-panel">
        <div class="heap-memory-demo__alloc-title">活动分配</div>
        <div class="heap-memory-demo__alloc-list" data-alloc-list></div>
      </div>
    </div>

    <div class="heap-memory-demo__heap-side">
      <div class="heap-memory-demo__heap-title">
        <strong>Heap View (16 blocks)</strong>
        <span>每格 = 1 个教学堆块</span>
      </div>

      <div class="heap-memory-demo__heap-wrap">
        <div class="heap-memory-demo__pointer" data-pointer-marker hidden>
          <span data-pointer-label>P</span>
          <b>▼</b>
        </div>

        <div class="heap-memory-demo__grid" data-heap-grid>
          {indexes.map((index) => (
            <div class="heap-memory-demo__cell" data-cell={String(index)}>
              <span></span>
            </div>
          ))}
        </div>

        <div class="heap-memory-demo__indexes">
          {indexes.map((index) => <span>{index}</span>)}
        </div>
      </div>

      <div class="heap-memory-demo__failure" data-failure hidden>
        <strong>malloc(5) → NULL</strong>
        <span>总空闲空间仍有 6 块，但最大连续空闲区只有 4 块，因此申请失败。</span>
      </div>

      <div class="heap-memory-demo__note">
        这里使用固定 16 块的教学模型。真实 malloc 还包含块头、对齐、空闲链表/桶等分配器元数据。
      </div>
    </div>
  </div>
</section>

<style is:global>
  .heap-memory-demo {
    --hmd-border: color-mix(in srgb, currentColor 14%, transparent);
    --hmd-muted: color-mix(in srgb, currentColor 58%, transparent);
    margin: 1.5rem 0 2rem;
    padding: 1rem;
    border: 1px solid var(--hmd-border);
    border-radius: 1rem;
    background: color-mix(in srgb, currentColor 2.5%, transparent);
  }

  .heap-memory-demo__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: .9rem;
  }
  .heap-memory-demo__header h3 { margin: 0; font-size: 1.08rem; }
  .heap-memory-demo__header p { margin: .28rem 0 0; color: var(--hmd-muted); font-size: .82rem; }

  .heap-memory-demo__legend { display: flex; flex-wrap: wrap; gap: .7rem; color: var(--hmd-muted); font-size: .7rem; }
  .heap-memory-demo__legend span { display: inline-flex; align-items: center; gap: .3rem; white-space: nowrap; }
  .heap-memory-demo__dot { display: inline-block; width: .65rem; height: .65rem; border-radius: 50%; }
  .heap-memory-demo__dot--used { background: #365a96; }
  .heap-memory-demo__dot--free { border: 1px solid #64748b; background: #11131c; }
  .heap-memory-demo__dot--active { background: #facc15; }

  .heap-memory-demo__controls { display: flex; flex-wrap: wrap; align-items: center; gap: .52rem; margin-bottom: .75rem; }
  .heap-memory-demo__controls button {
    padding: .5rem .72rem;
    border: 1px solid var(--hmd-border);
    border-radius: .62rem;
    color: inherit;
    background: transparent;
    cursor: pointer;
    font-size: .78rem;
  }
  .heap-memory-demo__controls button:hover { background: color-mix(in srgb, currentColor 7%, transparent); }
  .heap-memory-demo__controls button:disabled { opacity: .4; cursor: not-allowed; }
  .heap-memory-demo__counter { margin-left: auto; color: var(--hmd-muted); font-size: .74rem; }

  .heap-memory-demo__summary { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .52rem; margin-bottom: .8rem; }
  .heap-memory-demo__summary > div { padding: .62rem .7rem; border: 1px solid var(--hmd-border); border-radius: .68rem; }
  .heap-memory-demo__summary span { display: block; color: var(--hmd-muted); font-size: .66rem; }
  .heap-memory-demo__summary strong { display: block; margin-top: .16rem; font-size: .84rem; }

  .heap-memory-demo__workspace {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    padding: 1rem;
    border-radius: .9rem;
    color: #e5e7eb;
    background: #020304;
  }

  .heap-memory-demo__code-side,
  .heap-memory-demo__heap-side {
    width: 100%;
    min-width: 0;
  }

  .heap-memory-demo__code-panel,
  .heap-memory-demo__alloc-panel {
    overflow: hidden;
    border: 2px dashed #0ea5e9;
    border-radius: .9rem;
    background: #030712;
  }
  .heap-memory-demo__alloc-panel { margin-top: .72rem; border-color: #64748b; }
  .heap-memory-demo__code-title,
  .heap-memory-demo__alloc-title { padding: .5rem .72rem .1rem; color: #94a3b8; font-size: .72rem; font-weight: 700; }
  .heap-memory-demo__code-list {
    margin: 0;
    padding: .35rem .5rem .65rem;
    list-style: none;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: .8rem;
    line-height: 1.45;
  }
  .heap-memory-demo__code-line {
    margin: .1rem 0;
    padding: .12rem .45rem;
    border: 2px solid transparent;
    border-radius: .38rem;
    color: #dbeafe;
    white-space: pre;
    transition: background 150ms ease, border-color 150ms ease, color 150ms ease, opacity 150ms ease;
  }
  .heap-memory-demo__code-line[data-state="active"] { border-color: #facc15; background: rgba(250, 204, 21, .12); color: #fef08a; }
  .heap-memory-demo__code-line[data-state="done"] { color: #86efac; opacity: .72; }

  .heap-memory-demo__explain {
    margin-top: .72rem;
    min-height: 3.3rem;
    padding: .72rem .82rem;
    border-left: 3px solid #3b82f6;
    border-radius: .4rem;
    color: #cbd5e1;
    background: rgba(30, 41, 59, .45);
    font-size: .76rem;
  }

  .heap-memory-demo__alloc-list { display: flex; flex-wrap: wrap; gap: .45rem; padding: .55rem .65rem .72rem; }
  .heap-memory-demo__alloc-item {
    min-width: 118px;
    padding: .42rem .5rem;
    border: 1px solid rgba(148,163,184,.25);
    border-radius: .52rem;
    background: rgba(15,23,42,.78);
    color: #cbd5e1;
    font-size: .68rem;
    line-height: 1.45;
  }
  .heap-memory-demo__alloc-item strong { color: #f8fafc; }
  .heap-memory-demo__alloc-empty { color: #94a3b8; font-size: .7rem; }

  .heap-memory-demo__heap-side {
    padding-top: .95rem;
    border-top: 1px solid rgba(148, 163, 184, .18);
  }
  .heap-memory-demo__heap-title { display: flex; justify-content: space-between; align-items: flex-end; gap: .7rem; margin-bottom: .7rem; }
  .heap-memory-demo__heap-title strong { font-size: .92rem; }
  .heap-memory-demo__heap-title span { color: #94a3b8; font-size: .66rem; }
  .heap-memory-demo__heap-wrap {
    position: relative;
    width: 100%;
    padding-top: 2rem;
    padding-bottom: .4rem;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .heap-memory-demo__pointer {
    position: absolute;
    top: 0;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform: translateX(-50%);
    color: #fca5a5;
    font-size: .7rem;
    font-weight: 900;
    transition: left 220ms ease;
  }
  .heap-memory-demo__pointer b { color: #f87171; line-height: 1; font-size: 1rem; }

  .heap-memory-demo__grid,
  .heap-memory-demo__indexes {
    display: grid;
    grid-template-columns: repeat(16, minmax(34px, 1fr));
    gap: .24rem;
    min-width: 720px;
  }
  .heap-memory-demo__cell {
    position: relative;
    height: 78px;
    border: 2px solid #454956;
    border-radius: .4rem;
    background: #11131c;
    transition: background 180ms ease, border-color 180ms ease, transform 180ms ease, opacity 180ms ease;
  }
  .heap-memory-demo__cell[data-state="p"] { background: #516789; border-color: #7185a6; }
  .heap-memory-demo__cell[data-state="q"] { background: #3c5e94; border-color: #6381b1; }
  .heap-memory-demo__cell[data-state="r"] { background: #446d9f; border-color: #6790bc; }
  .heap-memory-demo__cell[data-state="s"] { background: #315887; border-color: #567aa4; }
  .heap-memory-demo__cell[data-state="t"] { background: #426c9a; border-color: #6e94bd; }
  .heap-memory-demo__cell[data-state="u"] { background: #6b5aa6; border-color: #8a78c0; }
  .heap-memory-demo__cell span { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #f8fafc; font-size: .76rem; font-weight: 800; }
  .heap-memory-demo__indexes { margin-top: .3rem; color: #94a3b8; font-size: .62rem; text-align: center; }

  .heap-memory-demo__failure {
    margin-top: .9rem;
    padding: .72rem .82rem;
    border: 1px dashed #ef4444;
    border-radius: .55rem;
    color: #fecaca;
    background: rgba(127,29,29,.34);
  }
  .heap-memory-demo__failure[hidden] { display: none !important; }
  .heap-memory-demo__failure strong { display: block; }
  .heap-memory-demo__failure span { display: block; margin-top: .18rem; color: #fca5a5; font-size: .7rem; line-height: 1.45; }
  .heap-memory-demo__note { margin-top: .75rem; color: #94a3b8; font-size: .68rem; line-height: 1.5; }

  @media (max-width: 980px) {
    .heap-memory-demo__summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 620px) {
    .heap-memory-demo__header,
    .heap-memory-demo__heap-title { flex-direction: column; align-items: flex-start; }
    .heap-memory-demo__summary { grid-template-columns: 1fr; }
    .heap-memory-demo__counter { width: 100%; margin-left: 0; }
    .heap-memory-demo__workspace { padding: .7rem; }
    .heap-memory-demo__grid,
    .heap-memory-demo__indexes { grid-template-columns: repeat(16, minmax(30px, 1fr)); min-width: 640px; }
    .heap-memory-demo__cell { height: 64px; }
  }
</style>

<script>
  type Allocation = { name: string; start: number; size: number };
  type PointerInfo = { name: string; index: number } | null;
  type HeapStep = {
    title: string;
    line: number;
    explanation: string;
    heap: Array<string | null>;
    allocations: Allocation[];
    pointer: PointerInfo;
    failed?: boolean;
  };

  function initHeapMemoryDemo(root: HTMLElement): void {
    if (root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";

    const empty = (): Array<string | null> => Array(16).fill(null);
    const makeHeap = (entries: Array<[number, number, string]>): Array<string | null> => {
      const heap = empty();
      for (const [start, size, name] of entries) {
        for (let index = start; index < start + size; index += 1) heap[index] = name;
      }
      return heap;
    };

    const steps: HeapStep[] = [
      { title: "初始状态", line: 0, explanation: "16 个演示堆块全部空闲。malloc 必须找到一段足够大的连续空闲区。", heap: empty(), allocations: [], pointer: null },
      { title: "p = malloc(4)", line: 2, explanation: "first-fit 从块 0 开始找到 4 个连续空闲块，因此 p 指向块 0，块 0~3 被占用。", heap: makeHeap([[0,4,"p"]]), allocations: [{name:"p",start:0,size:4}], pointer: {name:"p",index:0} },
      { title: "q = malloc(4)", line: 3, explanation: "下一段足够大的连续空闲区从块 4 开始，q 获得块 4~7。", heap: makeHeap([[0,4,"p"],[4,4,"q"]]), allocations: [{name:"p",start:0,size:4},{name:"q",start:4,size:4}], pointer: {name:"q",index:4} },
      { title: "r = malloc(2)", line: 4, explanation: "r 申请 2 个连续块，因此获得块 8~9。", heap: makeHeap([[0,4,"p"],[4,4,"q"],[8,2,"r"]]), allocations: [{name:"p",start:0,size:4},{name:"q",start:4,size:4},{name:"r",start:8,size:2}], pointer: {name:"r",index:8} },
      { title: "free(q)", line: 5, explanation: "释放 q 后，块 4~7 重新变为空闲区。堆中间出现空洞，这是外部碎片形成的开始。", heap: makeHeap([[0,4,"p"],[8,2,"r"]]), allocations: [{name:"p",start:0,size:4},{name:"r",start:8,size:2}], pointer: null },
      { title: "s = malloc(3)", line: 6, explanation: "first-fit 优先使用最左侧足够大的空闲区。s 占用块 4~6，块 7 留下一个 1 块的小空洞。", heap: makeHeap([[0,4,"p"],[4,3,"s"],[8,2,"r"]]), allocations: [{name:"p",start:0,size:4},{name:"s",start:4,size:3},{name:"r",start:8,size:2}], pointer: {name:"s",index:4} },
      { title: "t = malloc(2)", line: 7, explanation: "块 7 只有 1 个空闲块，不足以满足 malloc(2)，因此 t 跳过该碎片并获得块 10~11。", heap: makeHeap([[0,4,"p"],[4,3,"s"],[8,2,"r"],[10,2,"t"]]), allocations: [{name:"p",start:0,size:4},{name:"s",start:4,size:3},{name:"r",start:8,size:2},{name:"t",start:10,size:2}], pointer: {name:"t",index:10} },
      { title: "free(r)", line: 8, explanation: "释放 r 后，块 8~9 变为空闲。此时空闲空间被分成 1 块和 2 块以及末尾 4 块等多段。", heap: makeHeap([[0,4,"p"],[4,3,"s"],[10,2,"t"]]), allocations: [{name:"p",start:0,size:4},{name:"s",start:4,size:3},{name:"t",start:10,size:2}], pointer: null },
      { title: "u = malloc(1)", line: 9, explanation: "u 只需要 1 块，因此 first-fit 正好利用块 7 的单块碎片。块 8~9 和 12~15 仍然为空闲。", heap: makeHeap([[0,4,"p"],[4,3,"s"],[7,1,"u"],[10,2,"t"]]), allocations: [{name:"p",start:0,size:4},{name:"s",start:4,size:3},{name:"u",start:7,size:1},{name:"t",start:10,size:2}], pointer: {name:"u",index:7} },
      { title: "v = malloc(5) → NULL", line: 10, explanation: "现在总空闲块数为 6，但它们分成块 8~9（2 块）和 12~15（4 块）。最大连续空闲区只有 4 块，所以 malloc(5) 无法成功。", heap: makeHeap([[0,4,"p"],[4,3,"s"],[7,1,"u"],[10,2,"t"]]), allocations: [{name:"p",start:0,size:4},{name:"s",start:4,size:3},{name:"u",start:7,size:1},{name:"t",start:10,size:2}], pointer: null, failed: true },
    ];

    const q = <T extends Element>(selector: string): T | null => root.querySelector<T>(selector);
    const stepIndexEl = q<HTMLElement>("[data-step-index]");
    const stepTotalEl = q<HTMLElement>("[data-step-total]");
    const stepTitleEl = q<HTMLElement>("[data-step-title]");
    const usedEl = q<HTMLElement>("[data-used]");
    const freeInfoEl = q<HTMLElement>("[data-free-info]");
    const pointerValueEl = q<HTMLElement>("[data-pointer-value]");
    const explanationEl = q<HTMLElement>("[data-explanation]");
    const allocListEl = q<HTMLElement>("[data-alloc-list]");
    const pointerMarker = q<HTMLElement>("[data-pointer-marker]");
    const pointerLabel = q<HTMLElement>("[data-pointer-label]");
    const failureEl = q<HTMLElement>("[data-failure]");
    const prevBtn = q<HTMLButtonElement>('[data-action="prev"]');
    const nextBtn = q<HTMLButtonElement>('[data-action="next"]');
    const playBtn = q<HTMLButtonElement>('[data-action="play"]');
    const resetBtn = q<HTMLButtonElement>('[data-action="reset"]');
    const cells = Array.from(root.querySelectorAll<HTMLElement>("[data-cell]"));
    const codeLines = Array.from(root.querySelectorAll<HTMLElement>("[data-code-line]"));

    if (!stepIndexEl || !stepTotalEl || !stepTitleEl || !usedEl || !freeInfoEl || !pointerValueEl || !explanationEl || !allocListEl || !pointerMarker || !pointerLabel || !failureEl || !prevBtn || !nextBtn || !playBtn || !resetBtn) return;

    let currentStep = 0;
    let timer = 0;
    stepTotalEl.textContent = String(steps.length);

    const stopTimer = (): void => {
      if (timer) window.clearInterval(timer);
      timer = 0;
      playBtn.textContent = "自动播放";
    };

    const largestFreeRun = (heap: Array<string | null>): number => {
      let best = 0;
      let current = 0;
      for (const value of heap) {
        if (value === null) {
          current += 1;
          best = Math.max(best, current);
        } else {
          current = 0;
        }
      }
      return best;
    };

    const renderAllocations = (allocations: Allocation[]): void => {
      allocListEl.replaceChildren();
      if (allocations.length === 0) {
        const emptyEl = document.createElement("div");
        emptyEl.className = "heap-memory-demo__alloc-empty";
        emptyEl.textContent = "当前没有活动分配。";
        allocListEl.append(emptyEl);
        return;
      }
      for (const allocation of allocations) {
        const item = document.createElement("div");
        item.className = "heap-memory-demo__alloc-item";
        const name = document.createElement("strong");
        name.textContent = allocation.name;
        item.append(name, document.createElement("br"), `起始块 ${allocation.start} · 大小 ${allocation.size} blocks`);
        allocListEl.append(item);
      }
    };

    const renderPointer = (pointer: PointerInfo): void => {
      if (!pointer) {
        pointerMarker.hidden = true;
        pointerValueEl.textContent = "NULL";
        return;
      }
      const cell = q<HTMLElement>(`[data-cell="${pointer.index}"]`);
      if (!cell) return;
      pointerMarker.hidden = false;
      pointerLabel.textContent = pointer.name;
      pointerValueEl.textContent = `${pointer.name} → block ${pointer.index}`;
      const left = cell.offsetLeft + cell.offsetWidth / 2;
      pointerMarker.style.left = `${left}px`;
    };

    const render = (): void => {
      const step = steps[currentStep];
      stepIndexEl.textContent = String(currentStep + 1);
      stepTitleEl.textContent = step.title;
      explanationEl.textContent = step.explanation;

      codeLines.forEach((line, index) => {
        delete line.dataset.state;
        if (index < step.line) line.dataset.state = "done";
        if (index === step.line) line.dataset.state = "active";
      });

      let used = 0;
      cells.forEach((cell, index) => {
        const value = step.heap[index];
        const label = cell.querySelector<HTMLElement>("span");
        delete cell.dataset.state;
        if (label) label.textContent = "";
        if (value !== null) {
          used += 1;
          cell.dataset.state = value;
          if (label) label.textContent = value;
        }
      });

      const totalFree = 16 - used;
      const largest = largestFreeRun(step.heap);
      usedEl.textContent = `${used} / 16`;
      freeInfoEl.textContent = `${totalFree} / ${largest}`;
      failureEl.hidden = !step.failed;
      renderAllocations(step.allocations);
      renderPointer(step.pointer);
      prevBtn.disabled = currentStep === 0;
      nextBtn.disabled = currentStep === steps.length - 1;
    };

    prevBtn.addEventListener("click", () => {
      stopTimer();
      currentStep = Math.max(0, currentStep - 1);
      render();
    });

    nextBtn.addEventListener("click", () => {
      stopTimer();
      currentStep = Math.min(steps.length - 1, currentStep + 1);
      render();
    });

    playBtn.addEventListener("click", () => {
      if (timer) {
        stopTimer();
        return;
      }
      playBtn.textContent = "暂停";
      timer = window.setInterval(() => {
        if (currentStep >= steps.length - 1) {
          stopTimer();
          return;
        }
        currentStep += 1;
        render();
      }, 1150);
    });

    resetBtn.addEventListener("click", () => {
      stopTimer();
      currentStep = 0;
      render();
    });

    window.addEventListener("resize", () => renderPointer(steps[currentStep].pointer));
    document.addEventListener("astro:before-swap", stopTimer, { once: true });
    render();
  }

  document.querySelectorAll<HTMLElement>("[data-heap-memory-demo]").forEach(initHeapMemoryDemo);
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>("[data-heap-memory-demo]").forEach(initHeapMemoryDemo);
  });
</script>
