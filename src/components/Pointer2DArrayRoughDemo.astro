<section class="ptr2d-rough not-prose" data-ptr2d-rough>
  <div class="ptr2d-rough__head">
    <div>
      <h3>二维数组与数组指针</h3>
      <p>下面假设 <code>sizeof(int) = 4</code>，起始地址仅用于演示步长关系。</p>
    </div>
    <button type="button" data-redraw>重新手绘</button>
  </div>

  <div class="ptr2d-rough__paper">
    <svg viewBox="0 0 1180 650" role="img" aria-label="二维数组与数组指针手绘图">
      <g data-rough-layer></g>
      <g class="ptr2d-rough__labels">
        <text x="60" y="54" class="p2-title">int B[2][3] = {{2,3,6},{4,5,8}}</text>
        <text x="58" y="98" class="p2-note">每一行都是一个 int[3]，整块内存仍然连续。</text>

        <text x="92" y="160" class="p2-addr">400</text>
        <text x="238" y="160" class="p2-addr">404</text>
        <text x="384" y="160" class="p2-addr">408</text>
        <text x="530" y="160" class="p2-addr">412</text>
        <text x="676" y="160" class="p2-addr">416</text>
        <text x="822" y="160" class="p2-addr">420</text>

        <text x="122" y="235" class="p2-val">2</text>
        <text x="268" y="235" class="p2-val">3</text>
        <text x="414" y="235" class="p2-val">6</text>
        <text x="560" y="235" class="p2-val">4</text>
        <text x="706" y="235" class="p2-val">5</text>
        <text x="852" y="235" class="p2-val">8</text>

        <text x="88" y="298" class="p2-code">B[0][0]</text>
        <text x="537" y="298" class="p2-code">B[1][0]</text>
        <text x="831" y="298" class="p2-code">B[1][2]</text>

        <text x="172" y="370" class="p2-row">B[0]：第一行 int[3]</text>
        <text x="612" y="370" class="p2-row">B[1]：第二行 int[3]</text>

        <text x="58" y="440" class="p2-code">B       → int (*)[3]，指向“1 行”</text>
        <text x="58" y="485" class="p2-code">B + 1   → 跳过 3 个 int：400 → 412</text>
        <text x="58" y="530" class="p2-code">*(B+1)  → B[1]，在表达式中通常再退化为 int *</text>
        <text x="58" y="575" class="p2-code">*(B+1)+2 → &B[1][2]：412 + 2×4 = 420</text>
        <text x="58" y="620" class="p2-em">*(*(B+1)+2) == B[1][2] == 8</text>
      </g>
    </svg>
  </div>
</section>

<style is:global>
  .ptr2d-rough { margin:1.1rem 0 1.9rem; }
  .ptr2d-rough__head { display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; margin-bottom:.7rem; }
  .ptr2d-rough__head h3 { margin:0; font-size:1rem; }
  .ptr2d-rough__head p { margin:.25rem 0 0; font-size:.76rem; opacity:.72; line-height:1.55; }
  .ptr2d-rough__head button { flex:none; padding:.44rem .72rem; border:1px solid color-mix(in srgb,currentColor 18%,transparent); border-radius:.6rem; background:transparent; color:inherit; font-size:.7rem; cursor:pointer; }
  .ptr2d-rough__paper { overflow-x:auto; border:1px solid rgba(148,163,184,.24); border-radius:.9rem; background:#fbfaf5; }
  .ptr2d-rough__paper svg { display:block; width:100%; min-width:920px; height:auto; }
  .ptr2d-rough__labels text { font-family:"Comic Sans MS","KaiTi","STKaiti",ui-monospace,monospace; fill:#202124; }
  .p2-title { font-size:26px; font-weight:700; }
  .p2-note { font-size:19px; }
  .p2-addr { font-size:20px; fill:#2f7d49 !important; font-weight:700; }
  .p2-val { font-size:30px; font-weight:700; }
  .p2-code { font-size:20px; }
  .p2-row { font-size:20px; fill:#aa531f !important; font-weight:700; }
  .p2-em { font-size:21px; fill:#7d4aaa !important; font-weight:700; }
</style>

<script is:inline type="module">
  const roughUrl = "https://cdn.jsdelivr.net/npm/roughjs@4.6.6/bundled/rough.esm.js";

  async function initPtr2dRough(root) {
    if (root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";

    const svg = root.querySelector("svg");
    const layer = root.querySelector("[data-rough-layer]");
    const redraw = root.querySelector("[data-redraw]");
    if (!svg || !layer || !redraw) return;

    const roughModule = await import(roughUrl);
    const rough = roughModule.default;
    let seed = 57;

    const drawArrow = (rc, x1, y1, x2, y2, color) => {
      const opts = { stroke:color, strokeWidth:2.1, roughness:1.45, bowing:1.05, seed };
      layer.appendChild(rc.line(x1,y1,x2,y2,opts));
      const angle = Math.atan2(y2-y1,x2-x1);
      const a = 13;
      layer.appendChild(rc.line(x2,y2,x2-a*Math.cos(angle-.55),y2-a*Math.sin(angle-.55),opts));
      layer.appendChild(rc.line(x2,y2,x2-a*Math.cos(angle+.55),y2-a*Math.sin(angle+.55),opts));
    };

    const draw = () => {
      layer.replaceChildren();
      const rc = rough.svg(svg);
      const base = { stroke:"#333", strokeWidth:1.7, roughness:1.55, bowing:1.15, seed };
      const add = (n) => layer.appendChild(n);

      const startX = 65;
      const y = 180;
      const w = 146;
      const h = 88;
      for (let i = 0; i < 6; i += 1) {
        const firstRow = i < 3;
        add(rc.rectangle(startX + i*w, y, w, h, {
          ...base,
          stroke:firstRow ? "#c99422" : "#3e8db7",
          fill:firstRow ? "#fff4c4" : "#e6f4fb",
          fillStyle:"hachure",
          hachureGap:9
        }));
      }

      add(rc.rectangle(57,168,438,116,{...base,stroke:"#c05b2a",strokeWidth:2.1}));
      add(rc.rectangle(495,168,438,116,{...base,stroke:"#3e78ae",strokeWidth:2.1}));

      drawArrow(rc, 70, 330, 488, 330, "#c05b2a");
      drawArrow(rc, 510, 330, 928, 330, "#3e78ae");
      drawArrow(rc, 986, 205, 986, 267, "#7d4aaa");

      add(rc.line(58,402,930,402,{...base,stroke:"#999",strokeWidth:1.1,strokeLineDash:[7,6]}));
      seed += 1;
    };

    draw();
    redraw.addEventListener("click", draw);
  }

  document.querySelectorAll("[data-ptr2d-rough]").forEach(initPtr2dRough);
  document.addEventListener("astro:page-load", () => document.querySelectorAll("[data-ptr2d-rough]").forEach(initPtr2dRough));
</script>
