<section class="smart-pointer-demo not-prose" data-smart-pointer-demo>
  <div class="smart-pointer-demo__head">
    <div>
      <h3>智能指针动态演示</h3>
      <p>点击不同操作，观察所有权、引用计数与对象生命周期如何变化。</p>
    </div>
    <button type="button" data-reset>重置</button>
  </div>

  <div class="smart-pointer-demo__tabs" role="tablist">
    <button type="button" data-mode="unique" class="is-active">unique_ptr</button>
    <button type="button" data-mode="shared">shared_ptr</button>
    <button type="button" data-mode="weak">weak_ptr</button>
  </div>

  <div class="smart-pointer-demo__scene">
    <div class="spd-card" data-p1>
      <strong data-p1-title>p</strong>
      <span data-p1-state>拥有对象</span>
    </div>

    <div class="spd-arrow" data-a1>→</div>

    <div class="spd-object" data-object>
      <strong>Heap Object</strong>
      <span data-object-state>alive</span>
    </div>

    <div class="spd-arrow" data-a2>←</div>

    <div class="spd-card" data-p2>
      <strong data-p2-title>q</strong>
      <span data-p2-state>空</span>
    </div>
  </div>

  <div class="smart-pointer-demo__meta">
    <span>strong: <b data-strong>1</b></span>
    <span>weak: <b data-weak>0</b></span>
    <span>对象状态: <b data-status>存活</b></span>
  </div>

  <div class="smart-pointer-demo__actions">
    <button type="button" data-action="primary">std::move(p → q)</button>
    <button type="button" data-action="secondary">reset()</button>
    <button type="button" data-action="tertiary">查看说明</button>
  </div>

  <div class="smart-pointer-demo__log" data-log>当前：p 独占 Heap Object。</div>
</section>

<style is:global>
  .smart-pointer-demo { margin:1.2rem 0 2rem; border:1px solid color-mix(in srgb,currentColor 14%,transparent); border-radius:1rem; padding:1rem; }
  .smart-pointer-demo__head { display:flex; justify-content:space-between; gap:1rem; align-items:flex-start; }
  .smart-pointer-demo__head h3 { margin:0; font-size:1rem; }
  .smart-pointer-demo__head p { margin:.25rem 0 0; font-size:.76rem; opacity:.7; }
  .smart-pointer-demo button { border:1px solid color-mix(in srgb,currentColor 18%,transparent); border-radius:.6rem; background:transparent; color:inherit; padding:.48rem .72rem; cursor:pointer; }
  .smart-pointer-demo__tabs { display:flex; gap:.5rem; margin:1rem 0; flex-wrap:wrap; }
  .smart-pointer-demo__tabs .is-active { font-weight:700; background:color-mix(in srgb,currentColor 10%,transparent); }
  .smart-pointer-demo__scene { display:grid; grid-template-columns:minmax(130px,1fr) 46px minmax(160px,1.2fr) 46px minmax(130px,1fr); align-items:center; gap:.5rem; min-height:190px; }
  .spd-card,.spd-object { min-height:95px; border-radius:.9rem; display:flex; flex-direction:column; justify-content:center; align-items:center; gap:.35rem; border:1px solid color-mix(in srgb,currentColor 18%,transparent); transition:.25s ease; text-align:center; padding:.8rem; }
  .spd-card { background:color-mix(in srgb,#4f8fd8 10%,transparent); }
  .spd-object { background:color-mix(in srgb,#e36a5d 10%,transparent); }
  .spd-arrow { text-align:center; font-size:1.8rem; opacity:.75; transition:.2s ease; }
  .smart-pointer-demo__meta { display:flex; gap:1rem; flex-wrap:wrap; font-size:.78rem; padding:.7rem 0; border-top:1px dashed color-mix(in srgb,currentColor 14%,transparent); border-bottom:1px dashed color-mix(in srgb,currentColor 14%,transparent); }
  .smart-pointer-demo__actions { display:flex; gap:.6rem; flex-wrap:wrap; margin-top:.85rem; }
  .smart-pointer-demo__log { margin-top:.85rem; font-size:.8rem; line-height:1.6; padding:.75rem; border-radius:.7rem; background:color-mix(in srgb,currentColor 5%,transparent); }
  .spd-dim { opacity:.28; transform:scale(.98); }
  .spd-dead { opacity:.35; filter:grayscale(1); }
  @media (max-width:760px) {
    .smart-pointer-demo__scene { grid-template-columns:1fr; }
    .spd-arrow { transform:rotate(90deg); }
  }
</style>

<script is:inline>
  function initSmartPointerDemo(root) {
    if (root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";

    const q = (s) => root.querySelector(s);
    const tabs = [...root.querySelectorAll("[data-mode]")];
    const p1 = q("[data-p1]");
    const p2 = q("[data-p2]");
    const obj = q("[data-object]");
    const a1 = q("[data-a1]");
    const a2 = q("[data-a2]");
    const p1Title = q("[data-p1-title]");
    const p2Title = q("[data-p2-title]");
    const p1State = q("[data-p1-state]");
    const p2State = q("[data-p2-state]");
    const objectState = q("[data-object-state]");
    const strong = q("[data-strong]");
    const weak = q("[data-weak]");
    const status = q("[data-status]");
    const log = q("[data-log]");
    const primary = q('[data-action="primary"]');
    const secondary = q('[data-action="secondary"]');
    const tertiary = q('[data-action="tertiary"]');
    const reset = q('[data-reset]');

    let mode = "unique";
    let step = 0;

    function render() {
      [p1,p2,obj].forEach(el => el.classList.remove("spd-dim","spd-dead"));
      a1.textContent = "→";
      a2.textContent = "←";

      if (mode === "unique") {
        p1Title.textContent = "p"; p2Title.textContent = "q";
        strong.textContent = step === 2 ? "0" : "1"; weak.textContent = "0";
        primary.textContent = "std::move(p → q)"; secondary.textContent = "q.reset()"; tertiary.textContent = "为什么不能复制？";
        if (step === 0) {
          p1State.textContent = "拥有对象"; p2State.textContent = "空"; p2.classList.add("spd-dim");
          a1.textContent = "→"; a2.textContent = ""; objectState.textContent = "alive"; status.textContent = "存活";
          log.textContent = "当前：p 独占 Heap Object。unique_ptr 不能复制。";
        } else if (step === 1) {
          p1State.textContent = "nullptr"; p2State.textContent = "接管对象"; p1.classList.add("spd-dim");
          a1.textContent = ""; a2.textContent = "←"; objectState.textContent = "alive"; status.textContent = "存活";
          log.textContent = "执行 std::move 后，所有权从 p 转移给 q，p 变为空。";
        } else {
          p1State.textContent = "nullptr"; p2State.textContent = "nullptr"; p1.classList.add("spd-dim"); p2.classList.add("spd-dim"); obj.classList.add("spd-dead");
          a1.textContent = ""; a2.textContent = ""; objectState.textContent = "destroyed"; status.textContent = "已析构";
          log.textContent = "q.reset() 释放对象；没有任何 unique_ptr 再拥有该资源。";
        }
      }

      if (mode === "shared") {
        p1Title.textContent = "sp1"; p2Title.textContent = "sp2";
        weak.textContent = "0";
        primary.textContent = "sp2 = sp1"; secondary.textContent = "sp1.reset()"; tertiary.textContent = "sp2.reset()";
        if (step === 0) {
          strong.textContent = "1"; p1State.textContent = "共享拥有"; p2State.textContent = "空"; p2.classList.add("spd-dim"); a1.textContent = "→"; a2.textContent = ""; objectState.textContent = "alive"; status.textContent = "存活"; log.textContent = "当前：只有 sp1 共享拥有对象，strong = 1。";
        } else if (step === 1) {
          strong.textContent = "2"; p1State.textContent = "共享拥有"; p2State.textContent = "共享拥有"; a1.textContent = "→"; a2.textContent = "←"; objectState.textContent = "alive"; status.textContent = "存活"; log.textContent = "复制 shared_ptr 后，sp1 与 sp2 指向同一对象，strong = 2。";
        } else if (step === 2) {
          strong.textContent = "1"; p1State.textContent = "空"; p2State.textContent = "共享拥有"; p1.classList.add("spd-dim"); a1.textContent = ""; a2.textContent = "←"; objectState.textContent = "alive"; status.textContent = "存活"; log.textContent = "sp1.reset() 后 strong = 1，对象仍由 sp2 管理。";
        } else {
          strong.textContent = "0"; p1State.textContent = "空"; p2State.textContent = "空"; p1.classList.add("spd-dim"); p2.classList.add("spd-dim"); obj.classList.add("spd-dead"); a1.textContent = ""; a2.textContent = ""; objectState.textContent = "destroyed"; status.textContent = "已析构"; log.textContent = "最后一个 shared_ptr 释放后，strong 降为 0，对象被自动析构。";
        }
      }

      if (mode === "weak") {
        p1Title.textContent = "sp"; p2Title.textContent = "wp";
        primary.textContent = "wp = sp"; secondary.textContent = "sp.reset()"; tertiary.textContent = "wp.lock()";
        if (step === 0) {
          strong.textContent = "1"; weak.textContent = "0"; p1State.textContent = "共享拥有"; p2State.textContent = "空"; p2.classList.add("spd-dim"); a1.textContent = "→"; a2.textContent = ""; objectState.textContent = "alive"; status.textContent = "存活"; log.textContent = "当前：sp 拥有对象，wp 尚未观察。";
        } else if (step === 1) {
          strong.textContent = "1"; weak.textContent = "1"; p1State.textContent = "共享拥有"; p2State.textContent = "只观察"; a1.textContent = "→"; a2.textContent = "⇢"; objectState.textContent = "alive"; status.textContent = "存活"; log.textContent = "weak_ptr 不增加 strong；对象仍只有一个 shared_ptr 所有者。";
        } else {
          strong.textContent = "0"; weak.textContent = "1"; p1State.textContent = "空"; p2State.textContent = "expired"; p1.classList.add("spd-dim"); obj.classList.add("spd-dead"); a1.textContent = ""; a2.textContent = "⇢"; objectState.textContent = "destroyed"; status.textContent = "已析构"; log.textContent = "sp 释放后对象被销毁，wp 仍存在但已过期；此时 lock() 得到空 shared_ptr。";
        }
      }
    }

    tabs.forEach(btn => btn.addEventListener("click", () => {
      mode = btn.dataset.mode;
      step = 0;
      tabs.forEach(x => x.classList.toggle("is-active", x === btn));
      render();
    }));

    primary.addEventListener("click", () => { if (mode === "unique") step = Math.max(step,1); if (mode === "shared") step = Math.max(step,1); if (mode === "weak") step = Math.max(step,1); render(); });
    secondary.addEventListener("click", () => { if (mode === "unique") step = 2; if (mode === "shared") step = Math.max(step,2); if (mode === "weak") step = 2; render(); });
    tertiary.addEventListener("click", () => {
      if (mode === "unique") log.textContent = "unique_ptr 的复制构造与复制赋值被禁用，因为同一资源不能同时有两个独占所有者；需要用 std::move 转移所有权。";
      if (mode === "shared") { step = 3; render(); }
      if (mode === "weak") log.textContent = step < 2 ? "wp.lock() 会临时获得一个 shared_ptr；成功时 strong 会在该临时 shared_ptr 生命周期内增加。" : "对象已销毁，因此 wp.lock() 返回空 shared_ptr。";
    });
    reset.addEventListener("click", () => { step = 0; render(); });
    render();
  }

  document.querySelectorAll("[data-smart-pointer-demo]").forEach(initSmartPointerDemo);
  document.addEventListener("astro:page-load", () => document.querySelectorAll("[data-smart-pointer-demo]").forEach(initSmartPointerDemo));
</script>
