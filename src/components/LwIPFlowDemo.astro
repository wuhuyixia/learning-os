<section class="lwip-demo not-prose" data-lwip-demo>
  <div class="lwip-demo__head">
    <div>
      <h3>lwIP 一次收发数据到底经过了谁？</h3>
      <p>点一下“发送”或“接收”，观察数据如何在应用、协议栈、网卡驱动之间流动。</p>
    </div>
    <div class="lwip-demo__controls" role="group" aria-label="lwIP 数据流演示">
      <button type="button" data-mode="tx">▶ 发送数据</button>
      <button type="button" data-mode="rx">◀ 接收数据</button>
    </div>
  </div>

  <div class="lwip-demo__track" data-track>
    <div class="lwip-demo__step" data-step="0">
      <strong>应用任务</strong>
      <span>send()/recv()</span>
    </div>
    <span class="lwip-demo__arrow">↔</span>
    <div class="lwip-demo__step" data-step="1">
      <strong>Socket / Netconn</strong>
      <span>给应用一个网络接口</span>
    </div>
    <span class="lwip-demo__arrow">↔</span>
    <div class="lwip-demo__step" data-step="2">
      <strong>tcpip_thread</strong>
      <span>lwIP 核心处理线程</span>
    </div>
    <span class="lwip-demo__arrow">↔</span>
    <div class="lwip-demo__step" data-step="3">
      <strong>TCP / UDP</strong>
      <span>端口、可靠性、数据报</span>
    </div>
    <span class="lwip-demo__arrow">↔</span>
    <div class="lwip-demo__step" data-step="4">
      <strong>IP</strong>
      <span>目标 IP 与路由</span>
    </div>
    <span class="lwip-demo__arrow">↔</span>
    <div class="lwip-demo__step" data-step="5">
      <strong>netif + pbuf</strong>
      <span>网卡抽象 + 数据缓冲</span>
    </div>
    <span class="lwip-demo__arrow">↔</span>
    <div class="lwip-demo__step" data-step="6">
      <strong>ETH / Wi-Fi 驱动</strong>
      <span>DMA、MAC、PHY</span>
    </div>
  </div>

  <div class="lwip-demo__status" aria-live="polite" data-status>
    选择一个方向开始演示。
  </div>
</section>

<style is:global>
  .lwip-demo { margin:1.25rem 0 2rem; padding:1rem; border:1px solid rgba(148,163,184,.25); border-radius:1rem; background:color-mix(in srgb,var(--color-bg, #fff) 96%,#79a9d7 4%); }
  .lwip-demo__head { display:flex; gap:1rem; align-items:flex-start; justify-content:space-between; margin-bottom:1rem; }
  .lwip-demo__head h3 { margin:0; font-size:1rem; }
  .lwip-demo__head p { margin:.3rem 0 0; font-size:.76rem; line-height:1.55; opacity:.72; }
  .lwip-demo__controls { display:flex; gap:.45rem; flex:none; }
  .lwip-demo__controls button { border:1px solid rgba(100,116,139,.28); border-radius:.65rem; padding:.48rem .7rem; background:transparent; color:inherit; cursor:pointer; font-size:.72rem; }
  .lwip-demo__controls button:hover { background:rgba(59,130,246,.08); }
  .lwip-demo__track { display:flex; align-items:stretch; gap:.4rem; overflow-x:auto; padding:.25rem 0 .55rem; }
  .lwip-demo__step { min-width:126px; min-height:86px; display:flex; flex-direction:column; justify-content:center; gap:.25rem; padding:.72rem; border:1px solid rgba(100,116,139,.22); border-radius:.8rem; background:rgba(255,255,255,.45); transition:transform .2s ease, box-shadow .2s ease, border-color .2s ease, background .2s ease; }
  .lwip-demo__step strong { font-size:.78rem; }
  .lwip-demo__step span { font-size:.66rem; line-height:1.4; opacity:.68; }
  .lwip-demo__step.is-active { transform:translateY(-4px); border-color:#3b82f6; background:rgba(59,130,246,.11); box-shadow:0 8px 22px rgba(15,23,42,.08); }
  .lwip-demo__arrow { align-self:center; opacity:.45; font-size:1.1rem; }
  .lwip-demo__status { margin-top:.45rem; padding:.65rem .8rem; border-radius:.7rem; background:rgba(15,23,42,.04); font-size:.72rem; line-height:1.55; }
  @media (max-width:700px) {
    .lwip-demo__head { flex-direction:column; }
    .lwip-demo__controls { width:100%; }
    .lwip-demo__controls button { flex:1; }
  }
</style>

<script is:inline>
  function initLwipDemo(root) {
    if (root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";

    const steps = [...root.querySelectorAll("[data-step]")];
    const status = root.querySelector("[data-status]");
    const buttons = [...root.querySelectorAll("[data-mode]")];
    let timer = null;

    const txText = [
      "应用调用 send()，把数据交给 lwIP。",
      "Socket/Netconn 把请求转交给协议栈核心。",
      "tcpip_thread 串行处理网络核心逻辑。",
      "TCP/UDP 加上端口、序号等传输层信息。",
      "IP 决定目标地址以及下一跳。",
      "数据进入 pbuf，并通过 netif 交给具体网卡。",
      "驱动、DMA、MAC/PHY 最终把帧发到网线上或无线链路。",
    ];
    const rxText = [
      "驱动从网卡/DMA 得到新到达的数据帧。",
      "netif 把帧送入 lwIP，数据通常由 pbuf 描述。",
      "IP 检查地址并把数据交给对应的上层协议。",
      "TCP/UDP 根据端口找到对应连接。",
      "tcpip_thread 完成协议状态机和缓存处理。",
      "Socket/Netconn 把可读数据交给应用接口。",
      "应用任务通过 recv() 读到最终数据。",
    ];

    const play = (mode) => {
      if (timer) clearInterval(timer);
      steps.forEach((step) => step.classList.remove("is-active"));
      const order = mode === "tx" ? [0,1,2,3,4,5,6] : [6,5,4,3,2,1,0];
      const text = mode === "tx" ? txText : rxText;
      let i = 0;

      const render = () => {
        steps.forEach((step) => step.classList.remove("is-active"));
        const stepIndex = order[i];
        steps[stepIndex]?.classList.add("is-active");
        if (status) status.textContent = text[i];
        i += 1;
        if (i >= order.length && timer) {
          clearInterval(timer);
          timer = null;
        }
      };

      render();
      timer = setInterval(render, 760);
    };

    buttons.forEach((button) => button.addEventListener("click", () => play(button.dataset.mode)));
  }

  document.querySelectorAll("[data-lwip-demo]").forEach(initLwipDemo);
  document.addEventListener("astro:page-load", () => document.querySelectorAll("[data-lwip-demo]").forEach(initLwipDemo));
</script>
