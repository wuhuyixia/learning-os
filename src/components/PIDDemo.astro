---
---

<div class="pid-demo" data-pid-demo>
  <div class="pid-demo__header">
    <div>
      <h3>PID 参数交互演示</h3>
      <p>选择 P / PI / PD / PID，或直接拖动参数，观察闭环阶跃响应。</p>
    </div>
    <button type="button" class="pid-demo__reset" data-reset>重置参数</button>
  </div>

  <div class="pid-demo__modes" aria-label="PID 控制模式">
    <button type="button" data-mode="P">P</button>
    <button type="button" data-mode="PI">PI</button>
    <button type="button" data-mode="PD">PD</button>
    <button type="button" data-mode="PID" aria-pressed="true">PID</button>
  </div>

  <div class="pid-demo__controls">
    <label>
      <span><strong>Kp</strong> 比例 Proportional</span>
      <output data-value="kp">1.20</output>
      <input data-param="kp" type="range" min="0" max="5" step="0.05" value="1.2" />
    </label>

    <label>
      <span><strong>Ki</strong> 积分 Integral</span>
      <output data-value="ki">0.70</output>
      <input data-param="ki" type="range" min="0" max="2" step="0.01" value="0.7" />
    </label>

    <label>
      <span><strong>Kd</strong> 微分 Derivative</span>
      <output data-value="kd">0.18</output>
      <input data-param="kd" type="range" min="0" max="2" step="0.01" value="0.18" />
    </label>

    <label>
      <span><strong>Setpoint</strong> 设定值</span>
      <output data-value="setpoint">60</output>
      <input data-param="setpoint" type="range" min="20" max="100" step="1" value="60" />
    </label>
  </div>

  <div class="pid-demo__chart-wrap">
    <svg class="pid-demo__chart" viewBox="0 0 760 360" role="img" aria-label="PID 闭环阶跃响应曲线">
      <g class="pid-demo__grid" data-grid></g>
      <g class="pid-demo__axes" data-axes></g>
      <path class="pid-demo__setpoint" data-setpoint-path></path>
      <path class="pid-demo__response" data-response-path></path>
      <g class="pid-demo__labels" data-labels></g>
    </svg>
    <div class="pid-demo__legend" aria-hidden="true">
      <span><i class="pid-demo__legend-setpoint"></i>设定值 Setpoint</span>
      <span><i class="pid-demo__legend-response"></i>实际响应 Response</span>
    </div>
  </div>

  <div class="pid-demo__metrics" aria-live="polite">
    <div><span>超调量 Overshoot</span><strong data-metric="overshoot">—</strong></div>
    <div><span>上升时间 Rise Time</span><strong data-metric="rise">—</strong></div>
    <div><span>稳定时间 Settling Time</span><strong data-metric="settling">—</strong></div>
    <div><span>稳态误差 Steady-state Error</span><strong data-metric="error">—</strong></div>
  </div>

  <p class="pid-demo__note">
    仿真对象采用带恢复项的简化二阶系统 J·y'' + B·y' + C·y = K·u，并加入输出限幅与积分抗饱和。该演示用于理解 PID 参数趋势，不代表具体电机的精确模型。
  </p>
</div>

<style>
  .pid-demo {
    --pid-border: color-mix(in srgb, currentColor 18%, transparent);
    --pid-muted: color-mix(in srgb, currentColor 62%, transparent);
    --pid-grid: color-mix(in srgb, currentColor 10%, transparent);
    margin: 1.5rem 0 2rem;
    padding: 1.25rem;
    border: 1px solid var(--pid-border);
    border-radius: 1rem;
    background: color-mix(in srgb, currentColor 3%, transparent);
  }

  .pid-demo__header {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.85rem;
  }

  .pid-demo__header h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .pid-demo__header p {
    margin: 0.3rem 0 0;
    color: var(--pid-muted);
    font-size: 0.9rem;
  }

  .pid-demo button {
    border: 1px solid var(--pid-border);
    border-radius: 0.7rem;
    padding: 0.42rem 0.72rem;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .pid-demo button:hover,
  .pid-demo button[aria-pressed="true"] {
    background: color-mix(in srgb, currentColor 9%, transparent);
  }

  .pid-demo button[aria-pressed="true"] {
    border-color: color-mix(in srgb, currentColor 38%, transparent);
    font-weight: 600;
  }

  .pid-demo__reset {
    flex: 0 0 auto;
  }

  .pid-demo__modes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .pid-demo__modes button {
    min-width: 3.2rem;
  }

  .pid-demo__controls {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem 1.2rem;
    margin-bottom: 1.1rem;
  }

  .pid-demo__controls label {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.35rem 0.8rem;
    font-size: 0.88rem;
  }

  .pid-demo__controls output {
    font-variant-numeric: tabular-nums;
  }

  .pid-demo__controls input[type="range"] {
    grid-column: 1 / -1;
    width: 100%;
    accent-color: currentColor;
  }

  .pid-demo__chart {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .pid-demo__grid line {
    stroke: var(--pid-grid);
    stroke-width: 1;
  }

  .pid-demo__axes line {
    stroke: var(--pid-muted);
    stroke-width: 1.2;
  }

  .pid-demo__labels text {
    fill: var(--pid-muted);
    font-size: 12px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .pid-demo__setpoint {
    fill: none;
    stroke: #2563eb;
    stroke-width: 2.2;
    stroke-dasharray: 9 7;
  }

  .pid-demo__response {
    fill: none;
    stroke: #dc2626;
    stroke-width: 2.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pid-demo__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.2rem;
    justify-content: center;
    margin-top: 0.25rem;
    font-size: 0.82rem;
    color: var(--pid-muted);
  }

  .pid-demo__legend span {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
  }

  .pid-demo__legend i {
    display: inline-block;
    width: 1.7rem;
    height: 0;
  }

  .pid-demo__legend-setpoint { border-top: 2px dashed #2563eb; }
  .pid-demo__legend-response { border-top: 3px solid #dc2626; }

  .pid-demo__metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .pid-demo__metrics div {
    padding: 0.75rem;
    border: 1px solid var(--pid-border);
    border-radius: 0.75rem;
  }

  .pid-demo__metrics span {
    display: block;
    color: var(--pid-muted);
    font-size: 0.78rem;
    line-height: 1.35;
  }

  .pid-demo__metrics strong {
    display: block;
    margin-top: 0.3rem;
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }

  .pid-demo__note {
    margin: 0.9rem 0 0;
    color: var(--pid-muted);
    font-size: 0.8rem;
  }

  @media (max-width: 700px) {
    .pid-demo { padding: 1rem; }
    .pid-demo__header { flex-direction: column; }
    .pid-demo__controls,
    .pid-demo__metrics { grid-template-columns: 1fr; }
  }
</style>

<script>
  type PIDPoint = { t: number; y: number };
  type PIDMode = "P" | "PI" | "PD" | "PID";
  type RenderOptions = { animate?: boolean };
  type SvgAttrs = Record<string, string | number>;

  function initPIDDemo(root: HTMLElement): void {
    if (root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";

    const getRequired = <T extends Element>(selector: string): T => {
      const element = root.querySelector<T>(selector);
      if (!element) throw new Error(`PID demo element not found: ${selector}`);
      return element;
    };

    const inputs = {
      kp: getRequired<HTMLInputElement>('[data-param="kp"]'),
      ki: getRequired<HTMLInputElement>('[data-param="ki"]'),
      kd: getRequired<HTMLInputElement>('[data-param="kd"]'),
      setpoint: getRequired<HTMLInputElement>('[data-param="setpoint"]'),
    };

    const values = {
      kp: getRequired<HTMLOutputElement>('[data-value="kp"]'),
      ki: getRequired<HTMLOutputElement>('[data-value="ki"]'),
      kd: getRequired<HTMLOutputElement>('[data-value="kd"]'),
      setpoint: getRequired<HTMLOutputElement>('[data-value="setpoint"]'),
    };

    const responsePath = getRequired<SVGPathElement>("[data-response-path]");
    const setpointPath = getRequired<SVGPathElement>("[data-setpoint-path]");
    const grid = getRequired<SVGGElement>("[data-grid]");
    const axes = getRequired<SVGGElement>("[data-axes]");
    const labels = getRequired<SVGGElement>("[data-labels]");
    const resetButton = getRequired<HTMLButtonElement>("[data-reset]");

    const metrics = {
      overshoot: getRequired<HTMLElement>('[data-metric="overshoot"]'),
      rise: getRequired<HTMLElement>('[data-metric="rise"]'),
      settling: getRequired<HTMLElement>('[data-metric="settling"]'),
      error: getRequired<HTMLElement>('[data-metric="error"]'),
    };

    const modeButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-mode]"));

    const width = 760;
    const height = 360;
    const margin = { left: 62, right: 20, top: 18, bottom: 44 };
    const plotW = width - margin.left - margin.right;
    const plotH = height - margin.top - margin.bottom;
    const duration = 12;

    const svgEl = <K extends keyof SVGElementTagNameMap>(tag: K, attrs: SvgAttrs = {}): SVGElementTagNameMap[K] => {
      const element = document.createElementNS("http://www.w3.org/2000/svg", tag);
      for (const [key, value] of Object.entries(attrs)) element.setAttribute(key, String(value));
      return element;
    };

    const xScale = (t: number): number => margin.left + (t / duration) * plotW;

    function simulate(): { points: PIDPoint[]; setpoint: number } {
      const kp = Number(inputs.kp.value);
      const ki = Number(inputs.ki.value);
      const kd = Number(inputs.kd.value);
      const setpoint = Number(inputs.setpoint.value);

      values.kp.value = kp.toFixed(2);
      values.ki.value = ki.toFixed(2);
      values.kd.value = kd.toFixed(2);
      values.setpoint.value = setpoint.toFixed(0);

      const dt = 0.01;
      const count = Math.floor(duration / dt) + 1;
      const points: PIDPoint[] = [];

      // 带恢复项的简化二阶对象：J*y'' + B*y' + C*y = K*u
      // P 控制会留下明显稳态误差，加入 I 后可直观看到误差被消除。
      const J = 0.22;
      const B = 0.72;
      const C = 0.55;
      const K = 1.0;
      const outputLimit = 120;
      const integralLimit = 120;

      let y = 0;
      let velocity = 0;
      let integral = 0;
      let prevError = setpoint;

      for (let i = 0; i < count; i += 1) {
        const t = i * dt;
        const error = setpoint - y;
        const derivative = (error - prevError) / dt;
        const rawOutput = kp * error + ki * integral + kd * derivative;
        const output = Math.max(-outputLimit, Math.min(outputLimit, rawOutput));

        // Conditional integration anti-windup：饱和时仅允许误差将控制量拉回线性区。
        const canIntegrate =
          Math.abs(rawOutput) < outputLimit ||
          (rawOutput >= outputLimit && error < 0) ||
          (rawOutput <= -outputLimit && error > 0);
        if (canIntegrate) {
          integral = Math.max(-integralLimit, Math.min(integralLimit, integral + error * dt));
        }

        const acceleration = (K * output - B * velocity - C * y) / J;
        velocity += acceleration * dt;
        y += velocity * dt;
        prevError = error;
        points.push({ t, y });
      }

      return { points, setpoint };
    }

    function getYBounds(points: PIDPoint[], setpoint: number): { min: number; max: number } {
      const valuesY = points.map((point) => point.y);
      const rawMin = Math.min(0, setpoint, ...valuesY);
      const rawMax = Math.max(0, setpoint, ...valuesY);
      const span = Math.max(rawMax - rawMin, Math.abs(setpoint) * 0.4, 20);
      const padding = span * 0.12;
      return { min: rawMin - padding, max: rawMax + padding };
    }

    function drawAxes(yMin: number, yMax: number): (y: number) => number {
      grid.replaceChildren();
      axes.replaceChildren();
      labels.replaceChildren();

      const yScale = (y: number): number => margin.top + plotH - ((y - yMin) / (yMax - yMin)) * plotH;

      for (let t = 0; t <= duration; t += 2) {
        const x = xScale(t);
        grid.append(svgEl("line", { x1: x, y1: margin.top, x2: x, y2: margin.top + plotH }));
        const text = svgEl("text", { x, y: height - 15, "text-anchor": "middle" });
        text.textContent = String(t);
        labels.append(text);
      }

      const yTicks = 5;
      for (let index = 0; index <= yTicks; index += 1) {
        const yValue = yMin + ((yMax - yMin) * index) / yTicks;
        const y = yScale(yValue);
        grid.append(svgEl("line", { x1: margin.left, y1: y, x2: margin.left + plotW, y2: y }));
        const text = svgEl("text", { x: margin.left - 10, y: y + 4, "text-anchor": "end" });
        text.textContent = yValue.toFixed(Math.abs(yMax - yMin) < 40 ? 1 : 0);
        labels.append(text);
      }

      axes.append(svgEl("line", {
        x1: margin.left,
        y1: margin.top + plotH,
        x2: margin.left + plotW,
        y2: margin.top + plotH,
      }));
      axes.append(svgEl("line", {
        x1: margin.left,
        y1: margin.top,
        x2: margin.left,
        y2: margin.top + plotH,
      }));

      const xLabel = svgEl("text", { x: margin.left + plotW, y: height - 15, "text-anchor": "end" });
      xLabel.textContent = "t / s";
      labels.append(xLabel);
      return yScale;
    }

    function getMetrics(points: PIDPoint[], setpoint: number): {
      overshoot: number;
      rise: number | null;
      settling: number | null;
      steadyError: number;
    } {
      const maxY = Math.max(...points.map((point) => point.y));
      const overshoot = Math.max(0, ((maxY - setpoint) / Math.max(Math.abs(setpoint), 1)) * 100);

      const t10 = points.find((point) => point.y >= setpoint * 0.1)?.t;
      const t90 = points.find((point) => point.y >= setpoint * 0.9)?.t;
      const rise = t10 !== undefined && t90 !== undefined ? t90 - t10 : null;

      const band = Math.max(0.02 * Math.abs(setpoint), 0.5);
      let settling: number | null = null;
      for (let i = points.length - 1; i >= 0; i -= 1) {
        if (Math.abs(points[i].y - setpoint) > band) {
          if (i < points.length - 1) settling = points[i + 1].t;
          break;
        }
      }

      const steadyError = setpoint - points[points.length - 1].y;
      return { overshoot, rise, settling, steadyError };
    }

    function setMode(mode: PIDMode): void {
      const presets: Record<PIDMode, { kp: string; ki: string; kd: string }> = {
        P: { kp: "1.2", ki: "0", kd: "0" },
        PI: { kp: "1.2", ki: "0.7", kd: "0" },
        PD: { kp: "1.2", ki: "0", kd: "0.18" },
        PID: { kp: "1.2", ki: "0.7", kd: "0.18" },
      };
      const preset = presets[mode];
      inputs.kp.value = preset.kp;
      inputs.ki.value = preset.ki;
      inputs.kd.value = preset.kd;
      for (const button of modeButtons) {
        button.setAttribute("aria-pressed", button.dataset.mode === mode ? "true" : "false");
      }
      render({ animate: true });
    }

    function markCustomMode(): void {
      for (const button of modeButtons) button.setAttribute("aria-pressed", "false");
    }

    let animationFrame = 0;

    function render({ animate = true }: RenderOptions = {}): void {
      cancelAnimationFrame(animationFrame);
      const { points, setpoint } = simulate();
      const bounds = getYBounds(points, setpoint);
      const yScale = drawAxes(bounds.min, bounds.max);

      const responseD = points
        .map((point, index) => `${index === 0 ? "M" : "L"}${xScale(point.t).toFixed(2)},${yScale(point.y).toFixed(2)}`)
        .join(" ");
      const setpointD = `M${xScale(0)},${yScale(setpoint)} L${xScale(duration)},${yScale(setpoint)}`;

      setpointPath.setAttribute("d", setpointD);
      responsePath.setAttribute("d", responseD);

      const result = getMetrics(points, setpoint);
      metrics.overshoot.textContent = `${result.overshoot.toFixed(1)} %`;
      metrics.rise.textContent = result.rise === null ? "未达到" : `${result.rise.toFixed(2)} s`;
      metrics.settling.textContent = result.settling === null ? `> ${duration} s` : `${result.settling.toFixed(2)} s`;
      metrics.error.textContent = result.steadyError.toFixed(2);

      if (!animate || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        responsePath.style.strokeDasharray = "none";
        responsePath.style.strokeDashoffset = "0";
        return;
      }

      const length = responsePath.getTotalLength();
      responsePath.style.strokeDasharray = String(length);
      responsePath.style.strokeDashoffset = String(length);
      const start = performance.now();
      const animationDuration = 360;

      const tick = (now: number): void => {
        const progress = Math.min(1, (now - start) / animationDuration);
        const eased = 1 - (1 - progress) ** 3;
        responsePath.style.strokeDashoffset = String(length * (1 - eased));
        if (progress < 1) {
          animationFrame = requestAnimationFrame(tick);
        } else {
          responsePath.style.strokeDasharray = "none";
          responsePath.style.strokeDashoffset = "0";
        }
      };
      animationFrame = requestAnimationFrame(tick);
    }

    for (const input of Object.values(inputs)) {
      input.addEventListener("input", () => {
        markCustomMode();
        render({ animate: false });
      });
      input.addEventListener("change", () => render({ animate: true }));
    }

    for (const button of modeButtons) {
      button.addEventListener("click", () => {
        const mode = button.dataset.mode as PIDMode | undefined;
        if (mode) setMode(mode);
      });
    }

    resetButton.addEventListener("click", () => {
      inputs.setpoint.value = "60";
      setMode("PID");
    });

    render({ animate: true });
  }

  document.querySelectorAll<HTMLElement>("[data-pid-demo]").forEach(initPIDDemo);
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>("[data-pid-demo]").forEach(initPIDDemo);
  });
</script>
