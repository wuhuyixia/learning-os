<section class="pointer-to-pointer-rough not-prose" data-pointer-to-pointer-rough>
  <div class="pointer-to-pointer-rough__head">
    <div>
      <h3>指向指针的指针（二级指针）</h3>
      <p><code>q</code> 保存 <code>p</code> 的地址，<code>p</code> 保存 <code>x</code> 的地址。</p>
    </div>
    <button type="button" data-redraw>重新手绘</button>
  </div>

  <div class="pointer-to-pointer-rough__paper">
    <svg viewBox="0 0 1080 520" role="img" aria-label="二级指针手绘关系图">
      <g data-rough-layer></g>
      <g class="pointer-to-pointer-rough__labels">
        <text x="55" y="58" class="ptp-code">int x = 5;</text>
        <text x="55" y="94" class="ptp-code">int *p = &amp;x;</text>
        <text x="55" y="130" class="ptp-code">int **q = &amp;p;</text>
        <text x="55" y="166" class="ptp-code">**q = 8;  // 等价于 x = 8</text>

        <text x="150" y="230" class="ptp-note">二级指针</text>
        <text x="475" y="230" class="ptp-note">一级指针</text>
        <text x="815" y="230" class="ptp-note">普通变量</text>

        <text x="165" y="345" class="ptp-purple">0x2000</text>
        <text x="150" y="405" class="ptp-small">q 保存 &amp;p</text>
        <text x="205" y="445" class="ptp-code">q</text>

        <text x="495" y="345" class="ptp-blue">0x3000</text>
        <text x="480" y="405" class="ptp-small">p 保存 &amp;x</text>
        <text x="535" y="445" class="ptp-code">p</text>

        <text x="835" y="345" class="ptp-red">5 / 8</text>
        <text x="815" y="405" class="ptp-small">x 保存数据</text>
        <text x="865" y="445" class="ptp-code">x</text>

        <text x="160" y="490" class="ptp-note">关系：q → p → x；*q 是 p，**q 就是 x 中的数据。</text>
      </g>
    </svg>
  </div>
</section>

<style is:global>
  .pointer-to-pointer-rough { margin:1rem 0 2rem; }
  .pointer-to-pointer-rough__head { display:flex; justify-content:space-between; gap:1rem; align-items:flex-start; margin-bottom:.7rem; }
  .pointer-to-pointer-rough__head h3 { margin:0; font-size:1rem; }
  .pointer-to-pointer-rough__head p { margin:.25rem 0 0; font-size:.76rem; opacity:.68; line-height:1.55; }
  .pointer-to-pointer-rough__head button { flex:none; padding:.44rem .7rem; border:1px solid color-mix(in srgb,currentColor 18%,transparent); border-radius:.55rem; background:transparent; color:inherit; font-size:.7rem; cursor:pointer; }
  .pointer-to-pointer-rough__paper { overflow-x:auto; border:1px solid rgba(148,163,184,.24); border-radius:.85rem; background:#fbfaf5; }
  .pointer-to-pointer-rough__paper svg { display:block; width:100%; min-width:800px; height:auto; }
  .pointer-to-pointer-rough__labels text { font-family:"Comic Sans MS","KaiTi","STKaiti",ui-monospace,monospace; fill:#202124; }
  .ptp-code { font-size:22px; }
  .ptp-small { font-size:17px; }
  .ptp-note { font-size:20px; }
  .ptp-purple { font-size:27px; font-weight:700; fill:#8b5cf6 !important; }
  .ptp-blue { font-size:27px; font-weight:700; fill:#2563eb !important; }
  .ptp-red { font-size:34px; font-weight:700; fill:#dc2626 !important; }
</style>

<script is:inline type="module">
  const roughUrl = "https://cdn.jsdelivr.net/npm/roughjs@4.6.6/bundled/rough.esm.js";

  async function initPointerToPointerRough(root) {
    if (root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";

    const svg = root.querySelector("svg");
    const layer = root.querySelector("[data-rough-layer]");
    const redraw = root.querySelector("[data-redraw]");
    if (!svg || !layer || !redraw) return;

    const roughModule = await import(roughUrl);
    const rough = roughModule.default;
    let seed = 23;

    const draw = () => {
      layer.replaceChildren();
      const rc = rough.svg(svg);
      const base = { stroke:"#333", strokeWidth:1.6, roughness:1.45, bowing:1.1, seed };
      const add = (node) => layer.appendChild(node);

      add(rc.rectangle(125, 265, 175, 115, { ...base, stroke:"#8b5cf6", fill:"#f2ecff", fillStyle:"hachure", hachureGap:8 }));
      add(rc.rectangle(455, 265, 175, 115, { ...base, stroke:"#2563eb", fill:"#e9f1ff", fillStyle:"hachure", hachureGap:8 }));
      add(rc.rectangle(795, 265, 175, 115, { ...base, stroke:"#dc2626", fill:"#fdecec", fillStyle:"hachure", hachureGap:8 }));

      add(rc.path("M 300 320 C 360 292, 405 292, 455 320", { ...base, stroke:"#8b5cf6", strokeWidth:2.3 }));
      add(rc.line(455, 320, 438, 309, { ...base, stroke:"#8b5cf6", strokeWidth:2.3 }));
      add(rc.line(455, 320, 438, 331, { ...base, stroke:"#8b5cf6", strokeWidth:2.3 }));

      add(rc.path("M 630 320 C 690 292, 742 292, 795 320", { ...base, stroke:"#2563eb", strokeWidth:2.3 }));
      add(rc.line(795, 320, 778, 309, { ...base, stroke:"#2563eb", strokeWidth:2.3 }));
      add(rc.line(795, 320, 778, 331, { ...base, stroke:"#2563eb", strokeWidth:2.3 }));

      seed += 1;
    };

    draw();
    redraw.addEventListener("click", draw);
  }

  document.querySelectorAll("[data-pointer-to-pointer-rough]").forEach(initPointerToPointerRough);
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll("[data-pointer-to-pointer-rough]").forEach(initPointerToPointerRough);
  });
</script>
