<section class="pointer-array-rough not-prose" data-pointer-array-rough>
  <div class="pointer-array-rough__head">
    <div>
      <h3>数组与指针：同一个起始地址，不同的含义</h3>
      <p>下面用 Rough.js 画一个手绘内存模型。示例地址仅用于说明关系。</p>
    </div>
    <button type="button" data-redraw>重新手绘</button>
  </div>

  <div class="pointer-array-rough__paper">
    <svg viewBox="0 0 1000 520" role="img" aria-label="数组、数组首元素和指针的手绘内存关系图">
      <g data-rough-layer></g>
      <g class="pointer-array-rough__labels">
        <text x="390" y="54" class="par-title">内存</text>
        <text x="535" y="54" class="par-code">int arr[] = {1, 2, 3};</text>

        <text x="118" y="210" class="par-red">10</text>
        <text x="105" y="282" class="par-small">0x1000</text>
        <text x="75" y="345" class="par-code">int a = 10;</text>
        <text x="75" y="382" class="par-code">&amp;a = 0x1000</text>

        <text x="410" y="128" class="par-index">0</text>
        <text x="500" y="128" class="par-index">1</text>
        <text x="590" y="128" class="par-index">2</text>
        <text x="408" y="210" class="par-red">1</text>
        <text x="498" y="210" class="par-red">2</text>
        <text x="588" y="210" class="par-red">3</text>
        <text x="392" y="282" class="par-small">0x1100</text>

        <text x="790" y="208" class="par-blue">0x1100</text>
        <text x="805" y="282" class="par-blue">pa</text>

        <text x="390" y="345" class="par-code">arr      → 首元素地址（多数表达式中）</text>
        <text x="390" y="382" class="par-code">&amp;arr[0] → int *</text>
        <text x="390" y="419" class="par-code">&amp;arr    → int (*)[3]</text>
        <text x="390" y="456" class="par-code">三者起始地址数值相同，但类型与步长不同</text>

        <text x="710" y="345" class="par-code">int *pa = &amp;arr[0];</text>
      </g>
    </svg>
  </div>
</section>

<style is:global>
  .pointer-array-rough { margin: 1rem 0 2rem; }
  .pointer-array-rough__head { display:flex; justify-content:space-between; gap:1rem; align-items:flex-start; margin-bottom:.7rem; }
  .pointer-array-rough__head h3 { margin:0; font-size:1rem; }
  .pointer-array-rough__head p { margin:.25rem 0 0; font-size:.76rem; opacity:.68; line-height:1.55; }
  .pointer-array-rough__head button { flex:none; padding:.44rem .7rem; border:1px solid color-mix(in srgb,currentColor 18%,transparent); border-radius:.55rem; background:transparent; color:inherit; font-size:.7rem; cursor:pointer; }
  .pointer-array-rough__paper { overflow-x:auto; border:1px solid rgba(148,163,184,.24); border-radius:.85rem; background:#fbfaf5; }
  .pointer-array-rough__paper svg { display:block; width:100%; min-width:760px; height:auto; }
  .pointer-array-rough__labels text { font-family:"Comic Sans MS","KaiTi","STKaiti",ui-monospace,monospace; fill:#202124; }
  .par-title { font-size:34px; font-weight:700; }
  .par-code { font-size:20px; }
  .par-small,.par-index { font-size:17px; }
  .par-red { font-size:34px; font-weight:700; fill:#dc3b2d !important; }
  .par-blue { font-size:20px; font-weight:700; fill:#1675b8 !important; }
</style>

<script is:inline type="module">
  const roughUrl = "https://cdn.jsdelivr.net/npm/roughjs@4.6.6/bundled/rough.esm.js";

  async function initPointerArrayRough(root) {
    if (root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";

    const svg = root.querySelector("svg");
    const layer = root.querySelector("[data-rough-layer]");
    const redraw = root.querySelector("[data-redraw]");
    if (!svg || !layer || !redraw) return;

    const roughModule = await import(roughUrl);
    const rough = roughModule.default;
    let seed = 18;

    const draw = () => {
      layer.replaceChildren();
      const rc = rough.svg(svg);
      const ink = "#252525";
      const red = "#d9483b";
      const blue = "#3182bd";
      const base = { stroke: ink, strokeWidth: 1.7, roughness: 1.5, bowing: 1.2, seed };

      const add = (node) => layer.appendChild(node);

      // 整条抽象内存带
      add(rc.rectangle(42, 145, 900, 105, { ...base, fill: "#fffdf8", fillStyle: "solid" }));
      for (let x = 82; x < 930; x += 40) {
        add(rc.line(x, 145, x, 250, { ...base, strokeWidth: 1.1 }));
      }

      // 普通变量 a，占用一个示意 int 块
      add(rc.rectangle(102, 151, 80, 93, {
        ...base,
        stroke: red,
        fill: "#fde7e2",
        fillStyle: "hachure",
        hachureGap: 7,
      }));

      // arr[0..2] 三个连续 int
      [390, 480, 570].forEach((x) => {
        add(rc.rectangle(x, 151, 90, 93, {
          ...base,
          stroke: red,
          fill: "#fff0eb",
          fillStyle: "hachure",
          hachureGap: 8,
        }));
      });
      add(rc.rectangle(384, 143, 282, 109, {
        ...base,
        stroke: red,
        strokeWidth: 2.2,
      }));

      // pa 保存 arr[0] 地址
      add(rc.rectangle(778, 151, 122, 93, {
        ...base,
        stroke: blue,
        fill: "#e8f2fb",
        fillStyle: "hachure",
        hachureGap: 7,
      }));

      // pa -> arr[0] 的手绘箭头
      add(rc.path("M 840 250 C 790 330, 620 322, 438 246", {
        ...base,
        stroke: blue,
        strokeWidth: 2.2,
      }));
      add(rc.line(438, 246, 456, 258, { ...base, stroke: blue, strokeWidth: 2.2 }));
      add(rc.line(438, 246, 459, 239, { ...base, stroke: blue, strokeWidth: 2.2 }));

      // 标注 arr、&arr[0]、&arr 都落在同一物理起点
      add(rc.line(390, 251, 390, 304, { ...base, stroke: blue }));
      add(rc.line(380, 304, 400, 304, { ...base, stroke: blue }));

      seed += 1;
    };

    draw();
    redraw.addEventListener("click", draw);
  }

  document.querySelectorAll("[data-pointer-array-rough]").forEach(initPointerArrayRough);
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll("[data-pointer-array-rough]").forEach(initPointerArrayRough);
  });
</script>
