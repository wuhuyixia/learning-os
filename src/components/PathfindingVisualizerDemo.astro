  @media(max-width:840px){
    .pf-main{grid-template-columns:1fr}
    .pf-info{position:static;order:-1}
    .pf-toolbar{align-items:flex-start;flex-direction:column}
    .pf-tool-group--right{justify-content:flex-start}
    .pf-board{max-width:none}
