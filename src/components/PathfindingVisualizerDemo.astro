  .pf-main{display:grid;grid-template-columns:minmax(0,1fr) 236px;gap:.8rem;align-items:start}
  .pf-board-card{
    min-width:0;padding:.68rem;border:1px solid var(--pf-line);border-radius:.88rem;
    background:linear-gradient(180deg,var(--pf-panel),var(--pf-bg));
  }
  .pf-board-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:.48rem;font:700 .52rem ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--pf-muted);letter-spacing:.05em}
  .pf-board-top [data-board-status]{color:var(--pf-accent)}

  .pf-board{
    display:grid;
    grid-template-columns:repeat(12,minmax(0,1fr));
    gap:3px;
