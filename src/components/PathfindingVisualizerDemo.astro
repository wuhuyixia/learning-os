  .pf-head{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;margin-bottom:.85rem}
  .pf-kicker{display:block;margin-bottom:.22rem;font:800 .52rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.16em;color:var(--pf-accent)}
  .pf-head h3{margin:0;font-size:1rem;letter-spacing:-.01em}
  .pf-head p{margin:.32rem 0 0;max-width:720px;font-size:.69rem;line-height:1.55;color:var(--pf-muted)}
  .pf-run{
    display:inline-flex;align-items:center;gap:.42rem;
