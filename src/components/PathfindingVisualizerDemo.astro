<section class="pf-demo not-prose" data-pf-demo>
  <div class="pf-head">
    <div>
      <h3>寻路算法可视化实验</h3>
      <p>基于 Unity 项目的核心思想做成浏览器版：编辑网格 → 选择算法 → 观察 Frontier / Visited / Path 的变化。</p>
    </div>
    <button type="button" class="pf-run" data-run>▶ 运行</button>
  </div>

  <div class="pf-algos" data-algos>
    <button data-algo="bfs" class="is-active">BFS</button>
    <button data-algo="dfs">DFS</button>
    <button data-algo="greedy">Greedy</button>
    <button data-algo="dijkstra">Dijkstra</button>
    <button data-algo="astar">A*</button>
    <button data-algo="bibfs">Bi-BFS</button>
    <button data-algo="floyd">Floyd</button>
    <button data-algo="bellman">Bellman-Ford</button>
  </div>

  <div class="pf-toolbar">
    <button data-tool="start" class="is-active">起点 S</button>
    <button data-tool="end">终点 E</button>
    <button data-tool="wall">障碍</button>
    <button data-tool="up">权重 +</button>
    <button data-tool="down">权重 −</button>
    <button data-clear>清除搜索</button>
    <button data-reset>完全重置</button>
    <label>速度
      <input type="range" min="10" max="220" value="55" data-speed />
    </label>
  </div>

  <div class="pf-main">
    <div class="pf-board-wrap">
      <div class="pf-board" data-board aria-label="寻路网格"></div>
      <div class="pf-legend">
        <span><i class="start"></i>起点</span>
        <span><i class="end"></i>终点</span>
        <span><i class="frontier"></i>Frontier</span>
        <span><i class="visited"></i>Visited</span>
        <span><i class="path"></i>Path</span>
        <span><i class="wall"></i>障碍</span>
      </div>
    </div>

    <aside class="pf-info">
      <h4 data-title>BFS · 广度优先搜索</h4>
      <p data-explain>使用队列逐层扩散。在无权网格中，第一次到达终点时得到最少步数路径。</p>

      <div class="pf-formula" data-formula>优先级：层数 / FIFO</div>

      <dl>
        <div><dt>状态</dt><dd data-state>等待运行</dd></div>
        <div><dt>访问节点</dt><dd data-visited>0</dd></div>
        <div><dt>循环步数</dt><dd data-steps>0</dd></div>
        <div><dt>路径长度</dt><dd data-length>—</dd></div>
        <div><dt>总代价</dt><dd data-cost>—</dd></div>
      </dl>

      <div class="pf-tip" data-tip>
        先点“终点 E”再选择一个格子；拖动“障碍”工具可以连续画墙。
      </div>
    </aside>
  </div>
</section>

<style is:global>
  .pf-demo{--empty:#f8fafc;--line:#dbe3ee;--start:#22c55e;--end:#ef4444;--frontier:#38bdf8;--visited:#818cf8;--path:#facc15;--wall:#334155;--accent:#2563eb;margin:1.3rem 0 2rem;padding:1rem;border:1px solid #dbe3ee;border-radius:1rem;background:#fff;color:#334155;box-shadow:0 10px 32px rgba(15,23,42,.04)}
  .dark .pf-demo{--empty:#111827;--line:#334155;background:#0f172a;color:#e2e8f0;border-color:#334155}
  .pf-head{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem}.pf-head h3{margin:0;font-size:1rem}.pf-head p{margin:.3rem 0 .85rem;font-size:.7rem;line-height:1.5;opacity:.7;max-width:700px}
  .pf-run{border:0;border-radius:.65rem;padding:.55rem .9rem;background:var(--accent);color:#fff;font-weight:700;cursor:pointer;flex:none}.pf-run:disabled{opacity:.5;cursor:not-allowed}
  .pf-algos,.pf-toolbar{display:flex;gap:.38rem;flex-wrap:wrap}.pf-algos{margin-bottom:.5rem}.pf-algos button,.pf-toolbar button{border:1px solid var(--line);border-radius:.55rem;padding:.4rem .58rem;background:transparent;color:inherit;font-size:.62rem;cursor:pointer}.pf-algos button.is-active{border-color:var(--accent);background:#dbeafe;color:#1d4ed8;font-weight:800}.dark .pf-algos button.is-active{background:#172554;color:#93c5fd}
  .pf-toolbar{align-items:center;margin-bottom:.75rem}.pf-toolbar button.is-active{background:#e0f2fe;border-color:#38bdf8;color:#0369a1}.dark .pf-toolbar button.is-active{background:#082f49;color:#7dd3fc}.pf-toolbar label{display:flex;align-items:center;gap:.35rem;margin-left:auto;font-size:.6rem;opacity:.76}.pf-toolbar input{width:95px}
  .pf-main{display:grid;grid-template-columns:minmax(0,1fr) 230px;gap:.8rem}.pf-board-wrap{min-width:0}.pf-board{display:grid;grid-template-columns:repeat(12,1fr);gap:2px;aspect-ratio:1/1;max-width:720px;touch-action:none;user-select:none}
  .pf-cell{position:relative;border:1px solid var(--line);border-radius:.24rem;background:var(--empty);min-width:0;cursor:crosshair;transition:background .12s,transform .14s,box-shadow .14s}.pf-cell:hover{box-shadow:inset 0 0 0 1px var(--accent)}.pf-cell.is-start{background:var(--start)}.pf-cell.is-end{background:var(--end)}.pf-cell.is-wall{background:var(--wall)}.pf-cell.is-frontier{background:var(--frontier);animation:pf-pop .22s ease}.pf-cell.is-visited{background:var(--visited);animation:pf-pop .22s ease}.pf-cell.is-path{background:var(--path);animation:pf-path .28s ease}.pf-cell b{position:absolute;inset:0;display:grid;place-items:center;font:800 clamp(.45rem,1.1vw,.7rem) ui-monospace,SFMono-Regular,Menlo,monospace;color:#fff;text-shadow:0 1px 2px rgba(0,0,0,.35)}.pf-cell .pf-weight{position:absolute;right:2px;bottom:1px;font:700 clamp(.38rem,.8vw,.54rem) ui-monospace,SFMono-Regular,Menlo,monospace;color:#475569;text-shadow:none}.dark .pf-cell .pf-weight{color:#cbd5e1}.pf-cell.weight-pos{background:#ffedd5}.pf-cell.weight-neg{background:#e0f2fe}.pf-cell.weight-pos.is-frontier,.pf-cell.weight-neg.is-frontier{background:var(--frontier)}.pf-cell.weight-pos.is-visited,.pf-cell.weight-neg.is-visited{background:var(--visited)}.pf-cell.weight-pos.is-path,.pf-cell.weight-neg.is-path{background:var(--path)}
  @keyframes pf-pop{50%{transform:translateY(-4px) scale(1.04)}}@keyframes pf-path{50%{transform:scale(1.12)}}
  .pf-legend{display:flex;flex-wrap:wrap;gap:.65rem;margin-top:.55rem;font-size:.56rem;opacity:.72}.pf-legend i{display:inline-block;width:.58rem;height:.58rem;margin-right:.22rem;border-radius:.18rem;vertical-align:-.08rem}.pf-legend i.start{background:var(--start)}.pf-legend i.end{background:var(--end)}.pf-legend i.frontier{background:var(--frontier)}.pf-legend i.visited{background:var(--visited)}.pf-legend i.path{background:var(--path)}.pf-legend i.wall{background:var(--wall)}
  .pf-info{padding:.8rem;border:1px solid var(--line);border-radius:.75rem;background:rgba(148,163,184,.05)}.pf-info h4{margin:0 0 .35rem;font-size:.78rem}.pf-info>p{margin:.2rem 0 .65rem;font-size:.62rem;line-height:1.5;opacity:.72}.pf-formula{padding:.5rem .55rem;border-radius:.5rem;background:rgba(37,99,235,.07);font:700 .58rem ui-monospace,SFMono-Regular,Menlo,monospace;color:#2563eb}.dark .pf-formula{color:#93c5fd}.pf-info dl{margin:.7rem 0}.pf-info dl div{display:flex;justify-content:space-between;gap:.5rem;padding:.38rem 0;border-bottom:1px dashed var(--line);font-size:.6rem}.pf-info dt{opacity:.65}.pf-info dd{margin:0;font-weight:800}.pf-tip{margin-top:.65rem;padding:.55rem;border-radius:.5rem;background:rgba(250,204,21,.12);font-size:.58rem;line-height:1.5}
  @media(max-width:820px){.pf-main{grid-template-columns:1fr}.pf-info{order:-1}.pf-toolbar label{margin-left:0}.pf-board{max-width:none}}
</style>

<script is:inline>
  function initPathfindingDemo(root){
    if(root.dataset.initialized==='true') return;
    root.dataset.initialized='true';

    const ROWS=12,COLS=12;
    const board=root.querySelector('[data-board]');
    const runBtn=root.querySelector('[data-run]');
    const speedInput=root.querySelector('[data-speed]');
    const stateEl=root.querySelector('[data-state]');
    const visitedEl=root.querySelector('[data-visited]');
    const stepsEl=root.querySelector('[data-steps]');
    const lengthEl=root.querySelector('[data-length]');
    const costEl=root.querySelector('[data-cost]');
    const titleEl=root.querySelector('[data-title]');
    const explainEl=root.querySelector('[data-explain]');
    const formulaEl=root.querySelector('[data-formula]');
    const tipEl=root.querySelector('[data-tip]');

    const meta={
      bfs:['BFS · 广度优先搜索','队列逐层扩散。在无权网格中，第一次到达终点时得到最少步数路径。','优先级：层数 / FIFO'],
      dfs:['DFS · 深度优先搜索','使用栈沿一条分支尽量深入，走不通再回退。它不保证最短路径。','优先级：后进先出 / LIFO'],
      greedy:['Greedy · 贪心最佳优先','只看当前位置离终点的启发式距离，方向感强，但可能绕远。','f(n) = h(n)'],
      dijkstra:['Dijkstra','始终扩展当前累计代价 g 最小的节点，适合非负权图。','f(n) = g(n)'],
      astar:['A*','同时考虑已经付出的代价 g 和到终点的估计 h。','f(n) = g(n) + h(n)'],
      bibfs:['Bi-BFS · 双向广搜','从起点和终点同时按层扩散，在中间相遇。这里按无权图演示。','两个 FIFO 队列双向扩散'],
      floyd:['Floyd-Warshall','先计算所有节点两两之间的最短路，再读取起点到终点的路径。','dist[i][j] = min(dist[i][j], dist[i][k]+dist[k][j])'],
      bellman:['Bellman-Ford','反复松弛所有边，可处理负权；若还能继续变小则说明存在负环。','重复 |V|-1 轮边松弛']
    };

    let algo='bfs',tool='start',running=false,pointerDown=false;
    let start={r:2,c:2},end={r:9,c:9};
    let nodes=[];

    function key(r,c){return r*COLS+c}
    function rc(k){return {r:Math.floor(k/COLS),c:k%COLS}}
    function delay(){return Number(speedInput.value)}
    function sleep(ms){return new Promise(function(resolve){setTimeout(resolve,ms)})}
    function h(a,b){const A=rc(a),B=rc(b);return Math.abs(A.r-B.r)+Math.abs(A.c-B.c)}

    function makeNodes(){
      nodes=[];
      for(let r=0;r<ROWS;r++) for(let c=0;c<COLS;c++) nodes.push({r:r,c:c,wall:false,weight:1,mark:'',parent:null,dist:Infinity});
      const walls=[[1,6],[2,6],[3,6],[4,6],[5,6],[6,6],[7,6],[8,6],[8,5],[8,4],[8,3]];
      walls.forEach(function(p){nodes[key(p[0],p[1])].wall=true});
    }

    function neighbors(k){
      const p=rc(k),out=[],ds=[[1,0],[-1,0],[0,1],[0,-1]];
      ds.forEach(function(d){const r=p.r+d[0],c=p.c+d[1];if(r>=0&&r<ROWS&&c>=0&&c<COLS&&!nodes[key(r,c)].wall) out.push(key(r,c))});
      return out;
    }

    function moveCost(k){return nodes[k].weight}

    function render(){
      board.innerHTML='';
      for(let i=0;i<nodes.length;i++){
        const n=nodes[i],cell=document.createElement('div');
        cell.className='pf-cell';
        if(n.wall) cell.classList.add('is-wall');
        if(n.mark) cell.classList.add('is-'+n.mark);
        if(n.weight>1) cell.classList.add('weight-pos');
        if(n.weight<1) cell.classList.add('weight-neg');
        if(i===key(start.r,start.c)) cell.classList.add('is-start');
        if(i===key(end.r,end.c)) cell.classList.add('is-end');
        cell.dataset.k=String(i);
        if(i===key(start.r,start.c)){const b=document.createElement('b');b.textContent='S';cell.appendChild(b)}
        else if(i===key(end.r,end.c)){const b=document.createElement('b');b.textContent='E';cell.appendChild(b)}
        if(n.weight!==1&&!n.wall){const w=document.createElement('span');w.className='pf-weight';w.textContent=(n.weight>0?'+':'')+n.weight;cell.appendChild(w)}
        board.appendChild(cell);
      }
    }

    function clearSearch(){
      nodes.forEach(function(n){n.mark='';n.parent=null;n.dist=Infinity});
      stateEl.textContent='等待运行';visitedEl.textContent='0';stepsEl.textContent='0';lengthEl.textContent='—';costEl.textContent='—';render();
    }

    function setAlgo(a){
      algo=a;root.querySelectorAll('[data-algo]').forEach(function(b){b.classList.toggle('is-active',b.dataset.algo===a)});
      titleEl.textContent=meta[a][0];explainEl.textContent=meta[a][1];formulaEl.textContent=meta[a][2];
      if((a==='dijkstra'||a==='astar')&&nodes.some(function(n){return !n.wall&&n.weight<0})) tipEl.textContent='当前地图含负权：Dijkstra/A* 不适用，请把负权调回非负，或改用 Bellman-Ford。';
      else if(a==='bfs'||a==='dfs'||a==='bibfs') tipEl.textContent='该算法按无权图演示：格子的权重不会影响扩展顺序。';
      else tipEl.textContent='橙色格表示较高代价，蓝色格可表示较低甚至负代价。';
      clearSearch();
    }

    function setTool(t){
      tool=t;root.querySelectorAll('[data-tool]').forEach(function(b){b.classList.toggle('is-active',b.dataset.tool===t)});
    }

    function edit(k){
      if(running) return;
      const n=nodes[k];
      if(tool==='start'){if(!n.wall){start={r:n.r,c:n.c};render()}}
      else if(tool==='end'){if(!n.wall){end={r:n.r,c:n.c};render()}}
      else if(tool==='wall'){
        if(k!==key(start.r,start.c)&&k!==key(end.r,end.c)){n.wall=!n.wall;n.weight=1;render()}
      }else if(tool==='up'){
        if(!n.wall){n.weight=Math.min(5,n.weight+1);render()}
      }else if(tool==='down'){
        if(!n.wall){n.weight=Math.max(-5,n.weight-1);render()}
      }
    }

    board.addEventListener('pointerdown',function(e){const c=e.target.closest('.pf-cell');if(!c)return;pointerDown=true;edit(Number(c.dataset.k));e.preventDefault()});
    board.addEventListener('pointerover',function(e){if(!pointerDown||tool==='start'||tool==='end')return;const c=e.target.closest('.pf-cell');if(c)edit(Number(c.dataset.k))});
    window.addEventListener('pointerup',function(){pointerDown=false});

    root.querySelectorAll('[data-algo]').forEach(function(b){b.addEventListener('click',function(){if(!running)setAlgo(b.dataset.algo)})});
    root.querySelectorAll('[data-tool]').forEach(function(b){b.addEventListener('click',function(){if(!running)setTool(b.dataset.tool)})});
    root.querySelector('[data-clear]').addEventListener('click',function(){if(!running)clearSearch()});
    root.querySelector('[data-reset]').addEventListener('click',function(){if(!running){makeNodes();start={r:2,c:2};end={r:9,c:9};clearSearch()}});

    function resetSearchData(){
      nodes.forEach(function(n){n.mark='';n.parent=null;n.dist=Infinity});
      visitedEl.textContent='0';stepsEl.textContent='0';lengthEl.textContent='—';costEl.textContent='—';
    }

    async function paint(k,type){
      if(k!==key(start.r,start.c)&&k!==key(end.r,end.c)) nodes[k].mark=type;
      render();await sleep(delay());
    }

    async function finish(parentMap,target){
      const path=[];let cur=target,guard=0;
      while(cur!=null&&guard++<nodes.length+5){path.push(cur);if(cur===key(start.r,start.c))break;cur=parentMap[cur]}
      if(path[path.length-1]!==key(start.r,start.c)){stateEl.textContent='不可达';return}
      path.reverse();let cost=0;
      for(let i=1;i<path.length;i++){cost+=moveCost(path[i]);await paint(path[i],'path')}
      lengthEl.textContent=String(path.length-1);costEl.textContent=String(cost);stateEl.textContent='找到路径';
    }

    async function bfs(useStack){
      const s=key(start.r,start.c),t=key(end.r,end.c),open=[s],seen=new Set([s]),parent={};let visited=0,steps=0;
      while(open.length){
        const cur=useStack?open.pop():open.shift();visited++;visitedEl.textContent=String(visited);await paint(cur,'visited');
        if(cur===t){await finish(parent,t);return}
        const nbs=neighbors(cur);if(useStack)nbs.reverse();
        for(const nb of nbs) if(!seen.has(nb)){seen.add(nb);parent[nb]=cur;open.push(nb);if(nb!==t)nodes[nb].mark='frontier'}
        steps++;stepsEl.textContent=String(steps);render();
      }
      stateEl.textContent='不可达';
    }

    async function greedy(){
      const s=key(start.r,start.c),t=key(end.r,end.c),open=[s],seen=new Set([s]),parent={};let visited=0,steps=0;
      while(open.length){
        open.sort(function(a,b){return h(a,t)-h(b,t)});
        const cur=open.shift();visited++;visitedEl.textContent=String(visited);await paint(cur,'visited');
        if(cur===t){await finish(parent,t);return}
        for(const nb of neighbors(cur)) if(!seen.has(nb)){seen.add(nb);parent[nb]=cur;open.push(nb);if(nb!==t)nodes[nb].mark='frontier'}
        steps++;stepsEl.textContent=String(steps);render();
      }
      stateEl.textContent='不可达';
    }

    async function bestFirst(isAstar){
      if(nodes.some(function(n){return !n.wall&&n.weight<0})){stateEl.textContent='存在负权，算法不适用';return}
      const s=key(start.r,start.c),t=key(end.r,end.c),open=[s],closed=new Set(),g={};g[s]=0;const parent={};let visited=0,steps=0;
      while(open.length){
        open.sort(function(a,b){return (g[a]+(isAstar?h(a,t):0))-(g[b]+(isAstar?h(b,t):0))});
        const cur=open.shift();if(closed.has(cur))continue;closed.add(cur);visited++;visitedEl.textContent=String(visited);await paint(cur,'visited');
        if(cur===t){await finish(parent,t);return}
        for(const nb of neighbors(cur)){
          if(closed.has(nb))continue;
          const ng=g[cur]+moveCost(nb);
          if(g[nb]===undefined||ng<g[nb]){g[nb]=ng;parent[nb]=cur;if(!open.includes(nb))open.push(nb);if(nb!==t)nodes[nb].mark='frontier'}
        }
        steps++;stepsEl.textContent=String(steps);render();
      }
      stateEl.textContent='不可达';
    }

    async function bibfs(){
      const s=key(start.r,start.c),t=key(end.r,end.c);if(s===t){lengthEl.textContent='0';costEl.textContent='0';stateEl.textContent='找到路径';return}
      let qf=[s],qb=[t],seenF=new Set([s]),seenB=new Set([t]),pf={},pb={},meet=null,visited=0,steps=0;
      while(qf.length&&qb.length&&!meet){
        const nq=[];for(const cur of qf){visited++;visitedEl.textContent=String(visited);await paint(cur,'visited');for(const nb of neighbors(cur)){if(!seenF.has(nb)){seenF.add(nb);pf[nb]=cur;nq.push(nb);if(seenB.has(nb)){meet=nb;break}if(nb!==t)nodes[nb].mark='frontier'}}if(meet)break}qf=nq;steps++;stepsEl.textContent=String(steps);render();if(meet)break;
        const nq2=[];for(const cur of qb){visited++;visitedEl.textContent=String(visited);await paint(cur,'visited');for(const nb of neighbors(cur)){if(!seenB.has(nb)){seenB.add(nb);pb[nb]=cur;nq2.push(nb);if(seenF.has(nb)){meet=nb;break}if(nb!==s)nodes[nb].mark='frontier'}}if(meet)break}qb=nq2;steps++;stepsEl.textContent=String(steps);render();
      }
      if(meet==null){stateEl.textContent='不可达';return}
      const left=[];let c=meet;while(c!==undefined){left.push(c);if(c===s)break;c=pf[c]}left.reverse();
      const right=[];c=pb[meet];while(c!==undefined){right.push(c);if(c===t)break;c=pb[c]}
      const path=left.concat(right);let cost=0;for(let i=1;i<path.length;i++){cost+=moveCost(path[i]);await paint(path[i],'path')}lengthEl.textContent=String(path.length-1);costEl.textContent=String(cost);stateEl.textContent='双向搜索相遇';
    }

    async function bellman(){
      const valid=nodes.map(function(_,i){return i}).filter(function(i){return !nodes[i].wall}),s=key(start.r,start.c),t=key(end.r,end.c),dist={},pre={};valid.forEach(function(i){dist[i]=Infinity});dist[s]=0;
      const edges=[];valid.forEach(function(a){neighbors(a).forEach(function(b){edges.push([a,b,moveCost(b)])})});let relax=0,steps=0;
      for(let it=1;it<valid.length;it++){
        let changed=false;
        for(const e of edges){const a=e[0],b=e[1],w=e[2];if(dist[a]!==Infinity&&dist[a]+w<dist[b]){dist[b]=dist[a]+w;pre[b]=a;changed=true;relax++;if(b!==s&&b!==t)nodes[b].mark='frontier'}}
        steps=it;visitedEl.textContent=String(relax);stepsEl.textContent=String(steps);render();await sleep(Math.max(10,delay()/2));if(!changed)break;
      }
      for(const e of edges) if(dist[e[0]]!==Infinity&&dist[e[0]]+e[2]<dist[e[1]]){stateEl.textContent='检测到负环';tipEl.textContent='在四邻接双向网格中，负权格很容易形成可反复绕行的负环，因此“最短路”可能没有有限下界。';return}
      if(dist[t]===Infinity){stateEl.textContent='不可达';return}
      await finish(pre,t);
    }

    async function floyd(){
      const valid=nodes.map(function(_,i){return i}).filter(function(i){return !nodes[i].wall}),n=valid.length,index=new Map();valid.forEach(function(k,i){index.set(k,i)});
      const D=Array.from({length:n},function(){return Array(n).fill(Infinity)}),N=Array.from({length:n},function(){return Array(n).fill(-1)});
      for(let i=0;i<n;i++){D[i][i]=0;for(const nb of neighbors(valid[i])){const j=index.get(nb);D[i][j]=moveCost(nb);N[i][j]=j}}
      let updates=0;
      for(let k=0;k<n;k++){for(let i=0;i<n;i++){if(D[i][k]===Infinity)continue;for(let j=0;j<n;j++){const nd=D[i][k]+D[k][j];if(nd<D[i][j]){D[i][j]=nd;N[i][j]=N[i][k];updates++}}}stepsEl.textContent=String(k+1);visitedEl.textContent=String(updates);if(k%4===0){stateEl.textContent='以节点 '+(k+1)+' / '+n+' 作为中转点';await sleep(Math.max(8,delay()/2))}}
      for(let i=0;i<n;i++) if(D[i][i]<0){stateEl.textContent='检测到负环';tipEl.textContent='Floyd 检测到 dist[i][i] < 0，说明存在负环，最短路径不再有有限解。';return}
      const si=index.get(key(start.r,start.c)),ti=index.get(key(end.r,end.c));if(si===undefined||ti===undefined||N[si][ti]===-1){stateEl.textContent='不可达';return}
      const path=[valid[si]];let cur=si,guard=0;while(cur!==ti&&guard++<n+2){cur=N[cur][ti];path.push(valid[cur])}
      let cost=0;for(let i=1;i<path.length;i++){cost+=moveCost(path[i]);await paint(path[i],'path')}lengthEl.textContent=String(path.length-1);costEl.textContent=String(cost);stateEl.textContent='全源最短路计算完成';
    }

    async function run(){
      if(running)return;
      running=true;runBtn.disabled=true;resetSearchData();render();stateEl.textContent='搜索中…';
      if(algo==='bfs')await bfs(false);
      else if(algo==='dfs')await bfs(true);
      else if(algo==='greedy')await greedy();
      else if(algo==='dijkstra')await bestFirst(false);
      else if(algo==='astar')await bestFirst(true);
      else if(algo==='bibfs')await bibfs();
      else if(algo==='bellman')await bellman();
      else if(algo==='floyd')await floyd();
      running=false;runBtn.disabled=false;
    }

    runBtn.addEventListener('click',run);
    makeNodes();render();setAlgo('bfs');setTool('start');
  }

  document.querySelectorAll('[data-pf-demo]').forEach(initPathfindingDemo);
  document.addEventListener('astro:page-load',function(){document.querySelectorAll('[data-pf-demo]').forEach(initPathfindingDemo)});
</script>