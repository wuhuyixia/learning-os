  @media(max-width:560px){
    .pf-demo{padding:.72rem}
    .pf-head{flex-direction:column}
    .pf-run{width:100%}
    .pf-board{gap:2px}
    .pf-algos button,.pf-toolbar button{padding:.38rem .52rem}
  }
  @media(prefers-reduced-motion:reduce){
    .pf-cell,.pf-run,.pf-algos button,.pf-toolbar button{transition:none!important}
  }
</style>

<script is:inline>
  function initPathfindingDemo(root){
    if(root.dataset.initialized==='true') return;
    root.dataset.initialized='true';

    const ROWS=12,COLS=12;
    const board=root.querySelector('[data-board]');
    const runBtn=root.querySelector('[data-run]');
    const runText=root.querySelector('[data-run-text]');
    const runIcon=root.querySelector('[data-run-icon]');
    const speedInput=root.querySelector('[data-speed]');
    const stateEl=root.querySelector('[data-state]');
    const visitedEl=root.querySelector('[data-visited]');
    const stepsEl=root.querySelector('[data-steps]');
    const lengthEl=root.querySelector('[data-length]');
    const costEl=root.querySelector('[data-cost]');
    const titleEl=root.querySelector('[data-title]');
    const explainEl=root.querySelector('[data-explain]');
    const formulaEl=root.querySelector('[data-formula]');
    const tipEl=root.querySelector('[data-tip]');
    const boardStatus=root.querySelector('[data-board-status]');

    const meta={
      bfs:['BFS · 广度优先搜索','队列逐层扩散。在无权网格中，第一次到达终点时得到最少步数路径。','优先级：层数 / FIFO'],
      dfs:['DFS · 深度优先搜索','使用栈沿一条分支尽量深入，走不通再回退。它不保证最短路径。','优先级：后进先出 / LIFO'],
      greedy:['Greedy · 贪心最佳优先','只看当前位置离终点的启发式距离，方向感强，但可能绕远。','f(n) = h(n)'],
      dijkstra:['Dijkstra','始终扩展当前累计代价 g 最小的节点，适合非负权图。','f(n) = g(n)'],
      astar:['A*','同时考虑已经付出的代价 g 和到终点的估计 h。','f(n) = g(n) + h(n)'],
      bibfs:['Bi-BFS · 双向广搜','从起点和终点同时按层扩散，在中间相遇。这里按无权图演示。','两个 FIFO 队列双向扩散'],
      floyd:['Floyd-Warshall','先计算所有节点两两之间的最短路，再读取起点到终点的路径。','dist[i][j] = min(dist[i][j], dist[i][k]+dist[k][j])'],
      bellman:['Bellman-Ford','反复松弛所有边，可处理负权；若还能继续变小则说明存在负环。','重复 |V|-1 轮边松弛']
    };

    let algo='bfs',tool='start',running=false,pointerDown=false;
    let start={r:2,c:2},end={r:9,c:9};
    let nodes=[],cells=[],currentCell=-1,lastPainted=-1;

    function key(r,c){return r*COLS+c}
    function rc(k){return {r:Math.floor(k/COLS),c:k%COLS}}
    function delay(){return Math.max(8,190-Number(speedInput.value))}
    function sleep(ms){return new Promise(function(resolve){setTimeout(resolve,ms)})}
    function frame(){return new Promise(function(resolve){requestAnimationFrame(function(){requestAnimationFrame(resolve)})})}
    function h(a,b){const A=rc(a),B=rc(b);return Math.abs(A.r-B.r)+Math.abs(A.c-B.c)}
    function moveCost(k){return nodes[k].weight}

    function makeNodes(){
      nodes=[];
      for(let r=0;r<ROWS;r++) for(let c=0;c<COLS;c++){
        nodes.push({r:r,c:c,wall:false,weight:1,mark:'',parent:null,dist:Infinity});
      }
      const walls=[[1,6],[2,6],[3,6],[4,6],[5,6],[6,6],[7,6],[8,6],[8,5],[8,4],[8,3]];
      walls.forEach(function(p){nodes[key(p[0],p[1])].wall=true});
    }

    function createBoard(){
      board.innerHTML='';
      cells=[];
      const frag=document.createDocumentFragment();
      for(let i=0;i<ROWS*COLS;i++){
        const cell=document.createElement('div');
        cell.className='pf-cell';
        cell.dataset.k=String(i);

        const main=document.createElement('b');
        main.className='pf-main-label';
        cell.appendChild(main);

        const weight=document.createElement('span');
        weight.className='pf-weight';
        cell.appendChild(weight);

        cells.push(cell);
        frag.appendChild(cell);
      }
      board.appendChild(frag);
    }

    function updateCell(i){
      const n=nodes[i],cell=cells[i];
      if(!cell) return;

      cell.classList.toggle('is-wall',n.wall);
      cell.classList.toggle('is-start',i===key(start.r,start.c));
      cell.classList.toggle('is-end',i===key(end.r,end.c));
      cell.classList.toggle('is-frontier',n.mark==='frontier');
      cell.classList.toggle('is-visited',n.mark==='visited');
      cell.classList.toggle('is-path',n.mark==='path');
      cell.classList.toggle('weight-pos',n.weight>1&&!n.wall);
      cell.classList.toggle('weight-neg',n.weight<1&&!n.wall);
      cell.classList.toggle('is-current',i===currentCell);

      const main=cell.querySelector('.pf-main-label');
      if(i===key(start.r,start.c)) main.textContent='S';
      else if(i===key(end.r,end.c)) main.textContent='E';
      else main.textContent='';

      const weight=cell.querySelector('.pf-weight');
      weight.textContent=(n.weight!==1&&!n.wall)?((n.weight>0?'+':'')+n.weight):'';
    }

    function updateMany(indices){
      indices.forEach(updateCell);
    }

    function updateAll(){
      for(let i=0;i<nodes.length;i++) updateCell(i);
    }

    function pulse(i,type){
      const cell=cells[i];
      if(!cell||window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const frames=type==='path'
        ?[{transform:'scale(.92)'},{transform:'scale(1.12)'},{transform:'scale(1)'}]
        :[{transform:'translateY(0) scale(.96)'},{transform:'translateY(-4px) scale(1.05)'},{transform:'translateY(0) scale(1)'}];
      cell.animate(frames,{duration:type==='path'?320:260,easing:'cubic-bezier(.22,1,.36,1)'});
    }

    function setCurrent(i){
      const prev=currentCell;
      currentCell=i;
      if(prev>=0) updateCell(prev);
      if(i>=0) updateCell(i);
    }

    function setMark(i,mark,animate){
      if(i===key(start.r,start.c)||i===key(end.r,end.c)){
        if(animate) pulse(i,mark);
        return;
      }
      if(nodes[i].mark===mark) return;
      nodes[i].mark=mark;
      updateCell(i);
      if(animate) pulse(i,mark);
    }

    function neighbors(k){
      const p=rc(k),out=[],ds=[[1,0],[-1,0],[0,1],[0,-1]];
      ds.forEach(function(d){
        const r=p.r+d[0],c=p.c+d[1];
        if(r>=0&&r<ROWS&&c>=0&&c<COLS&&!nodes[key(r,c)].wall) out.push(key(r,c));
      });
      return out;
    }

    function resetMetrics(){
      visitedEl.textContent='0';
      stepsEl.textContent='0';
      lengthEl.textContent='—';
      costEl.textContent='—';
    }

    function clearSearch(){
      nodes.forEach(function(n){n.mark='';n.parent=null;n.dist=Infinity});
      currentCell=-1;
      stateEl.textContent='等待运行';
      boardStatus.textContent='READY';
      resetMetrics();
      updateAll();
    }

    function setAlgo(a){
      algo=a;
      root.querySelectorAll('[data-algo]').forEach(function(b){
        b.classList.toggle('is-active',b.dataset.algo===a);
      });
      titleEl.textContent=meta[a][0];
      explainEl.textContent=meta[a][1];
      formulaEl.textContent=meta[a][2];

      if((a==='dijkstra'||a==='astar')&&nodes.some(function(n){return !n.wall&&n.weight<0})){
        tipEl.textContent='当前地图含负权：Dijkstra/A* 不适用。请把负权调回非负，或改用 Bellman-Ford。';
      }else if(a==='bfs'||a==='dfs'||a==='bibfs'){
        tipEl.textContent='该算法按无权图演示：格子的权重不会影响扩展顺序。';
      }else{
        tipEl.textContent='橙色格表示较高代价，蓝色格表示较低或负代价。';
      }
      clearSearch();
    }

    function setTool(t){
      tool=t;
      root.querySelectorAll('[data-tool]').forEach(function(b){
        b.classList.toggle('is-active',b.dataset.tool===t);
      });
    }

    function edit(k){
      if(running||k===lastPainted) return;
      lastPainted=k;
      const n=nodes[k];
      const oldStart=key(start.r,start.c);
      const oldEnd=key(end.r,end.c);

      if(tool==='start'&&!n.wall){
        start={r:n.r,c:n.c};
        updateMany([oldStart,k]);
      }else if(tool==='end'&&!n.wall){
        end={r:n.r,c:n.c};
        updateMany([oldEnd,k]);
      }else if(tool==='wall'){
        if(k!==key(start.r,start.c)&&k!==key(end.r,end.c)){
          n.wall=!n.wall;n.weight=1;n.mark='';
          updateCell(k);pulse(k,'frontier');
        }
      }else if(tool==='up'&&!n.wall){
        n.weight=Math.min(5,n.weight+1);
        updateCell(k);pulse(k,'frontier');
      }else if(tool==='down'&&!n.wall){
        n.weight=Math.max(-5,n.weight-1);
        updateCell(k);pulse(k,'frontier');
      }
    }

    board.addEventListener('pointerdown',function(e){
      const c=e.target.closest('.pf-cell');
      if(!c) return;
      pointerDown=true;
      lastPainted=-1;
      edit(Number(c.dataset.k));
      try{board.setPointerCapture(e.pointerId)}catch(_){}
      e.preventDefault();
    });

    board.addEventListener('pointerover',function(e){
      if(!pointerDown||tool==='start'||tool==='end') return;
      const c=e.target.closest('.pf-cell');
      if(c) edit(Number(c.dataset.k));
    });

    board.addEventListener('pointerup',function(){pointerDown=false;lastPainted=-1});
    board.addEventListener('pointercancel',function(){pointerDown=false;lastPainted=-1});
    board.addEventListener('pointerleave',function(){lastPainted=-1});

    root.querySelectorAll('[data-algo]').forEach(function(b){
      b.addEventListener('click',function(){if(!running)setAlgo(b.dataset.algo)});
    });
    root.querySelectorAll('[data-tool]').forEach(function(b){
      b.addEventListener('click',function(){if(!running)setTool(b.dataset.tool)});
    });
    root.querySelector('[data-clear]').addEventListener('click',function(){if(!running)clearSearch()});
    root.querySelector('[data-reset]').addEventListener('click',function(){
      if(!running){
        makeNodes();start={r:2,c:2};end={r:9,c:9};clearSearch();
      }
    });

    function resetSearchData(){
      nodes.forEach(function(n){n.mark='';n.parent=null;n.dist=Infinity});
      currentCell=-1;
      resetMetrics();
      updateAll();
    }

    async function visit(k){
      setCurrent(k);
      setMark(k,'visited',true);
      await frame();
      await sleep(delay());
    }

    async function showFrontier(indices){
      indices.forEach(function(i){setMark(i,'frontier',true)});
      await frame();
    }

    async function finish(parentMap,target){
      const path=[];
      let cur=target,guard=0;
      while(cur!=null&&guard++<nodes.length+5){
        path.push(cur);
        if(cur===key(start.r,start.c)) break;
        cur=parentMap[cur];
      }
      if(path[path.length-1]!==key(start.r,start.c)){
        stateEl.textContent='不可达';
        boardStatus.textContent='UNREACHABLE';
        setCurrent(-1);
        return;
      }

      path.reverse();
      let cost=0;
      stateEl.textContent='回溯路径…';
      boardStatus.textContent='TRACE PATH';

      for(let i=1;i<path.length;i++){
        cost+=moveCost(path[i]);
        setCurrent(path[i]);
        setMark(path[i],'path',true);
        await sleep(Math.max(20,delay()*.55));
      }

      setCurrent(-1);
      lengthEl.textContent=String(path.length-1);
      costEl.textContent=String(cost);
      stateEl.textContent='找到路径';
      boardStatus.textContent='DONE';
    }

    async function bfs(useStack){
      const s=key(start.r,start.c),t=key(end.r,end.c);
      const open=[s],seen=new Set([s]),parent={};
      let visited=0,steps=0;

      while(open.length){
        const cur=useStack?open.pop():open.shift();
        visited++;
        visitedEl.textContent=String(visited);
        await visit(cur);

        if(cur===t){await finish(parent,t);return}

        const nbs=neighbors(cur);
        if(useStack)nbs.reverse();
        const fresh=[];
        for(const nb of nbs){
          if(!seen.has(nb)){
            seen.add(nb);parent[nb]=cur;open.push(nb);fresh.push(nb);
          }
        }
        await showFrontier(fresh);
        steps++;
        stepsEl.textContent=String(steps);
      }

      setCurrent(-1);
      stateEl.textContent='不可达';
      boardStatus.textContent='UNREACHABLE';
    }

    async function greedy(){
      const s=key(start.r,start.c),t=key(end.r,end.c);
      const open=[s],seen=new Set([s]),parent={};
      let visited=0,steps=0;

      while(open.length){
        open.sort(function(a,b){return h(a,t)-h(b,t)});
        const cur=open.shift();
        visited++;
        visitedEl.textContent=String(visited);
        await visit(cur);

        if(cur===t){await finish(parent,t);return}

        const fresh=[];
        for(const nb of neighbors(cur)){
          if(!seen.has(nb)){
            seen.add(nb);parent[nb]=cur;open.push(nb);fresh.push(nb);
          }
        }
        await showFrontier(fresh);
        steps++;
        stepsEl.textContent=String(steps);
      }

      setCurrent(-1);
      stateEl.textContent='不可达';
      boardStatus.textContent='UNREACHABLE';
    }

    async function bestFirst(isAstar){
      if(nodes.some(function(n){return !n.wall&&n.weight<0})){
        stateEl.textContent='存在负权，算法不适用';
        boardStatus.textContent='INVALID WEIGHT';
        return;
      }

      const s=key(start.r,start.c),t=key(end.r,end.c);
      const open=[s],closed=new Set(),g={},parent={};
      g[s]=0;
      let visited=0,steps=0;

      while(open.length){
        open.sort(function(a,b){
          return (g[a]+(isAstar?h(a,t):0))-(g[b]+(isAstar?h(b,t):0));
        });

        const cur=open.shift();
        if(closed.has(cur)) continue;
        closed.add(cur);
        visited++;
        visitedEl.textContent=String(visited);
        await visit(cur);

        if(cur===t){await finish(parent,t);return}

        const fresh=[];
        for(const nb of neighbors(cur)){
          if(closed.has(nb)) continue;
          const ng=g[cur]+moveCost(nb);
          if(g[nb]===undefined||ng<g[nb]){
            g[nb]=ng;
            parent[nb]=cur;
            if(!open.includes(nb)){open.push(nb);fresh.push(nb)}
          }
        }
        await showFrontier(fresh);
        steps++;
        stepsEl.textContent=String(steps);
      }

      setCurrent(-1);
      stateEl.textContent='不可达';
      boardStatus.textContent='UNREACHABLE';
    }

    async function bibfs(){
      const s=key(start.r,start.c),t=key(end.r,end.c);
      if(s===t){
        lengthEl.textContent='0';costEl.textContent='0';stateEl.textContent='找到路径';boardStatus.textContent='DONE';return;
      }

      let qf=[s],qb=[t],seenF=new Set([s]),seenB=new Set([t]);
      const pf={},pb={};
      let meet=null,visited=0,steps=0;

      while(qf.length&&qb.length&&!meet){
        const nq=[],frontFresh=[];
        for(const cur of qf){
          visited++;visitedEl.textContent=String(visited);await visit(cur);
          for(const nb of neighbors(cur)){
            if(!seenF.has(nb)){
              seenF.add(nb);pf[nb]=cur;nq.push(nb);frontFresh.push(nb);
              if(seenB.has(nb)){meet=nb;break}
            }
          }
          if(meet)break;
        }
        await showFrontier(frontFresh);
        qf=nq;steps++;stepsEl.textContent=String(steps);
        if(meet)break;

        const nq2=[],backFresh=[];
        for(const cur of qb){
          visited++;visitedEl.textContent=String(visited);await visit(cur);
          for(const nb of neighbors(cur)){
            if(!seenB.has(nb)){
              seenB.add(nb);pb[nb]=cur;nq2.push(nb);backFresh.push(nb);
              if(seenF.has(nb)){meet=nb;break}
            }
          }
          if(meet)break;
        }
        await showFrontier(backFresh);
        qb=nq2;steps++;stepsEl.textContent=String(steps);
      }

      if(meet==null){
        setCurrent(-1);stateEl.textContent='不可达';boardStatus.textContent='UNREACHABLE';return;
      }

      const left=[];
      let c=meet;
      while(c!==undefined){
        left.push(c);
        if(c===s)break;
        c=pf[c];
      }
      left.reverse();

      const right=[];
      c=pb[meet];
      while(c!==undefined){
        right.push(c);
        if(c===t)break;
        c=pb[c];
      }

      const path=left.concat(right);
      let cost=0;
      stateEl.textContent='双向搜索相遇，回溯路径…';
      boardStatus.textContent='MEET';

      for(let i=1;i<path.length;i++){
        cost+=moveCost(path[i]);
        setCurrent(path[i]);
        setMark(path[i],'path',true);
        await sleep(Math.max(20,delay()*.55));
      }

      setCurrent(-1);
      lengthEl.textContent=String(path.length-1);
      costEl.textContent=String(cost);
      stateEl.textContent='双向搜索相遇';
      boardStatus.textContent='DONE';
    }

    async function bellman(){
      const valid=nodes.map(function(_,i){return i}).filter(function(i){return !nodes[i].wall});
      const s=key(start.r,start.c),t=key(end.r,end.c),dist={},pre={};
      valid.forEach(function(i){dist[i]=Infinity});
      dist[s]=0;

      const edges=[];
      valid.forEach(function(a){
        neighbors(a).forEach(function(b){edges.push([a,b,moveCost(b)])});
      });

      let relax=0;
      for(let it=1;it<valid.length;it++){
        let changed=false;
        const changedNodes=new Set();

        for(const e of edges){
          const a=e[0],b=e[1],w=e[2];
          if(dist[a]!==Infinity&&dist[a]+w<dist[b]){
            dist[b]=dist[a]+w;
            pre[b]=a;
            changed=true;
            relax++;
            changedNodes.add(b);
          }
        }

        changedNodes.forEach(function(i){setMark(i,'frontier',false)});
        visitedEl.textContent=String(relax);
        stepsEl.textContent=String(it);
        stateEl.textContent='第 '+it+' 轮边松弛';
        boardStatus.textContent='RELAX '+it;
        await frame();
        await sleep(Math.max(24,delay()*.65));

        if(!changed)break;
      }

      for(const e of edges){
        if(dist[e[0]]!==Infinity&&dist[e[0]]+e[2]<dist[e[1]]){
          stateEl.textContent='检测到负环';
          boardStatus.textContent='NEGATIVE CYCLE';
          tipEl.textContent='四邻接双向网格里，负权格容易形成可重复绕行的负环，因此最短路可能没有有限下界。';
          return;
        }
      }

      if(dist[t]===Infinity){
        stateEl.textContent='不可达';boardStatus.textContent='UNREACHABLE';return;
      }

      await finish(pre,t);
    }

    async function floyd(){
      const valid=nodes.map(function(_,i){return i}).filter(function(i){return !nodes[i].wall});
      const n=valid.length,index=new Map();
      valid.forEach(function(k,i){index.set(k,i)});

      const D=Array.from({length:n},function(){return Array(n).fill(Infinity)});
      const N=Array.from({length:n},function(){return Array(n).fill(-1)});

      for(let i=0;i<n;i++){
        D[i][i]=0;
        for(const nb of neighbors(valid[i])){
          const j=index.get(nb);
          D[i][j]=moveCost(nb);
          N[i][j]=j;
        }
      }

      let updates=0;
      for(let k=0;k<n;k++){
        for(let i=0;i<n;i++){
          if(D[i][k]===Infinity)continue;
          for(let j=0;j<n;j++){
            const nd=D[i][k]+D[k][j];
            if(nd<D[i][j]){
              D[i][j]=nd;
              N[i][j]=N[i][k];
              updates++;
            }
          }
        }

        stepsEl.textContent=String(k+1);
        visitedEl.textContent=String(updates);

        if(k%3===0){
          const nodeIndex=valid[k];
          setCurrent(nodeIndex);
          stateEl.textContent='中转节点 '+(k+1)+' / '+n;
          boardStatus.textContent='K = '+(k+1);
          await sleep(Math.max(18,delay()*.45));
        }
      }

      setCurrent(-1);

      for(let i=0;i<n;i++){
        if(D[i][i]<0){
          stateEl.textContent='检测到负环';
          boardStatus.textContent='NEGATIVE CYCLE';
          tipEl.textContent='Floyd 检测到 dist[i][i] < 0，说明存在负环，最短路径没有有限解。';
          return;
        }
      }

      const si=index.get(key(start.r,start.c)),ti=index.get(key(end.r,end.c));
      if(si===undefined||ti===undefined||N[si][ti]===-1){
        stateEl.textContent='不可达';boardStatus.textContent='UNREACHABLE';return;
      }

      const path=[valid[si]];
      let cur=si,guard=0;
      while(cur!==ti&&guard++<n+2){
        cur=N[cur][ti];
        path.push(valid[cur]);
      }

      let cost=0;
      for(let i=1;i<path.length;i++){
        cost+=moveCost(path[i]);
        setCurrent(path[i]);
        setMark(path[i],'path',true);
        await sleep(Math.max(20,delay()*.5));
      }

      setCurrent(-1);
      lengthEl.textContent=String(path.length-1);
      costEl.textContent=String(cost);
      stateEl.textContent='全源最短路计算完成';
      boardStatus.textContent='DONE';
    }

    async function run(){
      if(running)return;
      running=true;
      runBtn.disabled=true;
      runText.textContent='搜索中';
      runIcon.textContent='●';
      boardStatus.textContent='SEARCHING';
      resetSearchData();
      stateEl.textContent='搜索中…';
      await frame();

      try{
        if(algo==='bfs')await bfs(false);
        else if(algo==='dfs')await bfs(true);
        else if(algo==='greedy')await greedy();
        else if(algo==='dijkstra')await bestFirst(false);
        else if(algo==='astar')await bestFirst(true);
        else if(algo==='bibfs')await bibfs();
        else if(algo==='bellman')await bellman();
        else if(algo==='floyd')await floyd();
      }finally{
        setCurrent(-1);
        running=false;
        runBtn.disabled=false;
        runText.textContent='再次运行';
        runIcon.textContent='▶';
      }
    }

    runBtn.addEventListener('click',run);

    makeNodes();
    createBoard();
    updateAll();
    setAlgo('bfs');
    setTool('start');
  }

  document.querySelectorAll('[data-pf-demo]').forEach(initPathfindingDemo);
  document.addEventListener('astro:page-load',function(){
    document.querySelectorAll('[data-pf-demo]').forEach(initPathfindingDemo);
  });
</script>