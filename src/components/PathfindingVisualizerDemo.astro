  .pf-algos button.is-active{border-color:#60a5fa;background:var(--pf-accent-soft);color:#1d4ed8;font-weight:800;box-shadow:0 0 0 1px rgba(59,130,246,.08)}
  .dark .pf-algos button.is-active{color:#93c5fd}

  .pf-toolbar{display:flex;justify-content:space-between;align-items:center;gap:.6rem;margin-bottom:.75rem}
  .pf-tool-group{display:flex;gap:.36rem;flex-wrap:wrap;align-items:center}
  .pf-tool-group--right{justify-content:flex-end}
  .pf-toolbar button.is-active{background:#e0f2fe;border-color:#38bdf8;color:#0369a1;font-weight:700}
  .dark .pf-toolbar button.is-active{background:#082f49;color:#7dd3fc}
  .pf-speed{display:flex;align-items:center;gap:.42rem;padding:0 .15rem;font-size:.58rem;color:var(--pf-muted);white-space:nowrap}
