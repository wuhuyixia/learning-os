    cursor:crosshair;
    transform:translateZ(0);
    will-change:transform,background-color,box-shadow;
    transition:
      background-color .24s cubic-bezier(.22,1,.36,1),
      border-color .2s ease,
      box-shadow .22s ease,
      transform .22s cubic-bezier(.22,1,.36,1);
  }
  .pf-cell:hover{z-index:2;box-shadow:inset 0 0 0 1px #60a5fa,0 4px 12px rgba(37,99,235,.12)}
  .pf-cell.is-start{background:var(--pf-start);border-color:#16a34a}
  .pf-cell.is-end{background:var(--pf-end);border-color:#dc2626}
  .pf-cell.is-wall{background:var(--pf-wall);border-color:var(--pf-wall);transform:scale(.96)}
  .pf-cell.is-frontier{background:var(--pf-frontier);border-color:#0ea5e9}
  .pf-cell.is-visited{background:var(--pf-visited);border-color:#4f46e5}
  .pf-cell.is-path{background:var(--pf-path);border-color:#eab308;box-shadow:0 0 0 1px rgba(250,204,21,.18),0 4px 14px rgba(234,179,8,.22)}
  .pf-cell.is-current{
    z-index:3;
    box-shadow:0 0 0 2px var(--pf-current),0 7px 18px rgba(15,23,42,.2);
    transform:translateY(-3px) scale(1.035);
  }

  .pf-cell b{
    position:absolute;inset:0;display:grid;place-items:center;
    font:800 clamp(.44rem,1.1vw,.7rem) ui-monospace,SFMono-Regular,Menlo,monospace;
    color:#fff;text-shadow:0 1px 2px rgba(0,0,0,.34);pointer-events:none;
  }
  .pf-cell .pf-weight{
    position:absolute;right:2px;bottom:1px;
    font:800 clamp(.36rem,.76vw,.52rem) ui-monospace,SFMono-Regular,Menlo,monospace;
    color:#475569;pointer-events:none;
  }
  .dark .pf-cell .pf-weight{color:#cbd5e1}
  .pf-cell.weight-pos{background:#fff1df}
  .pf-cell.weight-neg{background:#e0f2fe}
  .dark .pf-cell.weight-pos{background:#422006}
  .dark .pf-cell.weight-neg{background:#082f49}
  .pf-cell.weight-pos.is-frontier,.pf-cell.weight-neg.is-frontier{background:var(--pf-frontier)}
  .pf-cell.weight-pos.is-visited,.pf-cell.weight-neg.is-visited{background:var(--pf-visited)}
  .pf-cell.weight-pos.is-path,.pf-cell.weight-neg.is-path{background:var(--pf-path)}

  .pf-legend{display:flex;flex-wrap:wrap;gap:.62rem;margin-top:.58rem;font-size:.55rem;color:var(--pf-muted)}
  .pf-legend i{display:inline-block;width:.58rem;height:.58rem;margin-right:.22rem;border-radius:.18rem;vertical-align:-.08rem}
  .pf-legend i.start{background:var(--pf-start)}
  .pf-legend i.end{background:var(--pf-end)}
  .pf-legend i.current{background:transparent;border:2px solid var(--pf-current)}
  .pf-legend i.frontier{background:var(--pf-frontier)}
  .pf-legend i.visited{background:var(--pf-visited)}
  .pf-legend i.path{background:var(--pf-path)}
  .pf-legend i.wall{background:var(--pf-wall)}

  .pf-info{
    position:sticky;top:1rem;
    padding:.85rem;
    border:1px solid var(--pf-line);
    border-radius:.88rem;
    background:linear-gradient(180deg,var(--pf-panel),var(--pf-bg));
  }
  .pf-info-head{display:flex;align-items:center;gap:.42rem}
  .pf-algo-dot{width:.58rem;height:.58rem;border-radius:50%;background:var(--pf-accent);box-shadow:0 0 0 4px rgba(37,99,235,.1)}
  .pf-info h4{margin:0;font-size:.77rem}
  .pf-info>p{margin:.42rem 0 .7rem;font-size:.61rem;line-height:1.55;color:var(--pf-muted)}
  .pf-formula{
    padding:.52rem .58rem;border-radius:.55rem;
    background:rgba(37,99,235,.07);
    font:700 .57rem/1.5 ui-monospace,SFMono-Regular,Menlo,monospace;color:#2563eb;
  }
  .dark .pf-formula{color:#93c5fd;background:rgba(59,130,246,.1)}
  .pf-metrics{display:grid;grid-template-columns:1fr 1fr;gap:.4rem;margin:.72rem 0}
  .pf-metrics>div{padding:.5rem;border:1px solid var(--pf-line);border-radius:.55rem;background:var(--pf-bg)}
  .pf-metrics span{display:block;margin-bottom:.18rem;font-size:.52rem;color:var(--pf-muted)}
  .pf-metrics strong{font:800 .68rem ui-monospace,SFMono-Regular,Menlo,monospace}
  .pf-metrics>div:first-child{grid-column:1/-1}
