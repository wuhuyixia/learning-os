---
const rowCount = 24;
const stackOrigin = 0x20001000;
const addresses = Array.from({ length: rowCount }, (_, index) =>
  `0x${(stackOrigin - index - 1).toString(16).toUpperCase()}`,
);

const mainCode = [
  "int main(void)",
  "{",
  "    uint8_t  a = 12;",
  "    uint16_t b = 100;",
  "    uint16_t c = a + b;",
  "    uint32_t d = 4000;",
  "    uint8_t  e = 240;",
  "    uint32_t f = 9;",
  "    do_nothing();",
  "    uint16_t g = 10;",
  "    do_nothing();",
  "}",
];

const helperCode = [
  "void do_nothing(void)",
  "{",
  "    uint16_t a = 100;",
  "    uint8_t  b = 30;",
  "}",
];

const recursiveCode = [
  "void recurse(uint32_t depth)",
  "{",
  "    uint8_t buf[4];",
  "    recurse(depth + 1);",
  "}",
  "",
  "int main(void)",
  "{",
  "    recurse(0);",
  "}",
];
---

<section class="stack-frame-demo not-prose" data-stack-frame-demo>
  <div class="stack-frame-demo__header">
    <div>
      <h3>代码执行与函数栈帧可视化</h3>
      <p>教学模型：1 格 = 1 Byte；uint8_t / uint16_t / uint32_t 分别占 1 / 2 / 4 格，32 位返回地址 RET 占 4 格。</p>
    </div>
    <div class="stack-frame-demo__legend">
      <span><i class="stack-frame-demo__dot stack-frame-demo__dot--main"></i>main 栈帧</span>
      <span><i class="stack-frame-demo__dot stack-frame-demo__dot--func"></i>do_nothing 栈帧</span>
      <span><i class="stack-frame-demo__dot stack-frame-demo__dot--active"></i>当前执行</span>
    </div>
  </div>

  <div class="stack-frame-demo__controls">
    <button type="button" data-action="prev">上一步</button>
    <button type="button" data-action="next">下一步</button>
    <button type="button" data-action="play">自动播放</button>
    <button type="button" data-action="overflow">递归溢出演示</button>
    <button type="button" data-action="reset">重置</button>
    <span class="stack-frame-demo__counter">步骤 <strong data-step-index>1</strong> / <span data-step-total>1</span></span>
  </div>

  <div class="stack-frame-demo__summary">
    <div><span>当前动作</span><strong data-step-title>进入 main()</strong></div>
    <div><span>活动栈帧</span><strong data-active-frame>main</strong></div>
    <div><span>已用空间</span><strong data-used-space>0 / 24 B</strong></div>
    <div><span>SP</span><strong data-sp-value>0x20001000</strong></div>
  </div>

  <div class="stack-frame-demo__workspace">
    <div class="stack-frame-demo__code-side">
      <div data-normal-code>
        <div class="stack-frame-code stack-frame-code--helper">
          <div class="stack-frame-code__title">do_nothing()</div>
          <ol class="stack-frame-code__list">
            {helperCode.map((line, index) => (
              <li class="stack-frame-code__line" data-panel="helper" data-line={String(index)}>{line}</li>
            ))}
          </ol>
        </div>

        <div class="stack-frame-code stack-frame-code--main">
          <div class="stack-frame-code__title">main()</div>
          <ol class="stack-frame-code__list">
            {mainCode.map((line, index) => (
              <li class="stack-frame-code__line" data-panel="main" data-line={String(index)}>{line}</li>
            ))}
          </ol>
        </div>
      </div>

      <div class="stack-frame-code stack-frame-code--recursive" data-recursive-code hidden>
        <div class="stack-frame-code__title">递归导致 Stack Overflow</div>
        <ol class="stack-frame-code__list">
          {recursiveCode.map((line, index) => (
            <li class="stack-frame-code__line" data-panel="recursive" data-line={String(index)}>{line || " "}</li>
          ))}
        </ol>
      </div>

      <div class="stack-frame-demo__explain" data-explanation>
        main() 开始执行。SP 初始位于 Stack Origin，局部变量尚未占用演示栈空间。
      </div>
    </div>

    <div class="stack-frame-demo__memory-side">
      <div class="stack-frame-demo__memory-title">
        <strong>Stack Memory</strong>
        <span>高地址在上 · 向低地址增长 ↓</span>
      </div>

      <div class="stack-memory-board">
        <div class="stack-memory-addresses">
          {addresses.map((address) => <span>{address}</span>)}
        </div>

        <div class="stack-memory-column">
          <div class="stack-memory-origin"><span>Stack Origin</span><b>▶</b></div>
          <div class="stack-memory-grid">
            {addresses.map(() => <span></span>)}
          </div>
          <div class="stack-memory-blocks" data-blocks></div>
          <div class="stack-memory-sp" data-sp-marker>SP ▶</div>
          <div class="stack-memory-overflow" data-overflow-banner>
            <strong>STACK OVERFLOW</strong>
            <span>继续压栈会越过 24 Byte 演示边界</span>
          </div>
        </div>

        <div class="stack-frame-column" data-brackets></div>
      </div>
    </div>
  </div>

  <div class="stack-frame-demo__note">
    注：该动画用于解释“栈帧、返回地址和局部变量占用”的核心概念。真实 ARM/MCU 编译结果还会受 ABI、栈对齐、保存寄存器和编译优化影响。
  </div>
</section>

<style is:global>
  .stack-frame-demo {
    --sfd-row: 22px;
    --sfd-rows: 24;
    --sfd-border: color-mix(in srgb, currentColor 14%, transparent);
    --sfd-muted: color-mix(in srgb, currentColor 58%, transparent);
    margin: 1.5rem 0 2rem;
    padding: 1rem;
    border: 1px solid var(--sfd-border);
    border-radius: 1rem;
    background: color-mix(in srgb, currentColor 2.5%, transparent);
  }

  .stack-frame-demo__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: .9rem;
  }
  .stack-frame-demo__header h3 { margin: 0; font-size: 1.08rem; }
  .stack-frame-demo__header p { margin: .28rem 0 0; color: var(--sfd-muted); font-size: .82rem; }

  .stack-frame-demo__legend { display: flex; flex-wrap: wrap; gap: .7rem; color: var(--sfd-muted); font-size: .7rem; }
  .stack-frame-demo__legend span { display: inline-flex; align-items: center; gap: .3rem; white-space: nowrap; }
  .stack-frame-demo__dot { width: .65rem; height: .65rem; border-radius: 50%; display: inline-block; }
  .stack-frame-demo__dot--main { background: #0ea5e9; }
  .stack-frame-demo__dot--func { background: #a855f7; }
  .stack-frame-demo__dot--active { background: #facc15; }

  .stack-frame-demo__controls { display: flex; flex-wrap: wrap; align-items: center; gap: .52rem; margin-bottom: .75rem; }
  .stack-frame-demo__controls button {
    padding: .5rem .72rem;
    border: 1px solid var(--sfd-border);
    border-radius: .62rem;
    color: inherit;
    background: transparent;
    cursor: pointer;
    font-size: .78rem;
  }
  .stack-frame-demo__controls button:hover { background: color-mix(in srgb, currentColor 7%, transparent); }
  .stack-frame-demo__controls button:disabled { opacity: .4; cursor: not-allowed; }
  .stack-frame-demo__controls [data-action="overflow"] { border-color: rgba(220, 38, 38, .45); }
  .stack-frame-demo__counter { margin-left: auto; color: var(--sfd-muted); font-size: .74rem; }

  .stack-frame-demo__summary { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .52rem; margin-bottom: .8rem; }
  .stack-frame-demo__summary > div { padding: .62rem .7rem; border: 1px solid var(--sfd-border); border-radius: .68rem; }
  .stack-frame-demo__summary span { display: block; color: var(--sfd-muted); font-size: .66rem; }
  .stack-frame-demo__summary strong { display: block; margin-top: .16rem; font-size: .84rem; }

  .stack-frame-demo__workspace {
    display: grid;
    grid-template-columns: minmax(360px, 1.08fr) minmax(440px, 1fr);
    gap: 1rem;
    padding: 1rem;
    border-radius: .9rem;
    color: #e5e7eb;
    background: #020304;
  }

  .stack-frame-demo__code-side { min-width: 0; }
  .stack-frame-demo__code-side [data-normal-code] { display: flex; flex-direction: column; gap: .72rem; }
  .stack-frame-demo__code-side [hidden] { display: none !important; }

  .stack-frame-code {
    overflow: hidden;
    border: 2px dashed #0ea5e9;
    border-radius: .9rem;
    background: #030712;
  }
  .stack-frame-code--helper { border-color: #a855f7; }
  .stack-frame-code--recursive { border-color: #ef4444; }
  .stack-frame-code__title { padding: .5rem .72rem .1rem; color: #94a3b8; font-size: .72rem; font-weight: 700; }
  .stack-frame-code__list {
    margin: 0;
    padding: .35rem .5rem .65rem;
    list-style: none;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: .8rem;
    line-height: 1.45;
  }
  .stack-frame-code__line {
    margin: .1rem 0;
    padding: .12rem .45rem;
    border: 2px solid transparent;
    border-radius: .38rem;
    color: #dbeafe;
    white-space: pre;
    transition: background 150ms ease, border-color 150ms ease, color 150ms ease, opacity 150ms ease;
  }
  .stack-frame-code__line[data-state="active"] { border-color: #facc15; background: rgba(250, 204, 21, .12); color: #fef08a; }
  .stack-frame-code__line[data-state="call"] { border-color: #a855f7; background: rgba(168, 85, 247, .14); color: #f5d0fe; }
  .stack-frame-code__line[data-state="done"] { color: #86efac; opacity: .72; }

  .stack-frame-demo__explain {
    margin-top: .72rem;
    min-height: 3.2rem;
    padding: .72rem .82rem;
    border-left: 3px solid #3b82f6;
    border-radius: .4rem;
    color: #cbd5e1;
    background: rgba(30, 41, 59, .45);
    font-size: .76rem;
  }

  .stack-frame-demo__memory-side { min-width: 0; overflow-x: auto; padding-bottom: 3.4rem; }
  .stack-frame-demo__memory-title { display: flex; justify-content: space-between; align-items: flex-end; gap: .7rem; margin-bottom: .62rem; }
  .stack-frame-demo__memory-title strong { font-size: .92rem; }
  .stack-frame-demo__memory-title span { color: #94a3b8; font-size: .66rem; }

  .stack-memory-board {
    display: grid;
    grid-template-columns: 96px 170px 150px;
    gap: .62rem;
    min-width: 436px;
    align-items: start;
  }

  .stack-memory-addresses {
    display: grid;
    grid-template-rows: repeat(var(--sfd-rows), var(--sfd-row));
    color: #ef4444;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: .58rem;
  }
  .stack-memory-addresses span { display: flex; align-items: center; justify-content: flex-end; }

  .stack-memory-column {
    position: relative;
    width: 170px;
  }
  .stack-memory-grid,
  .stack-memory-blocks {
    display: grid;
    grid-template-rows: repeat(var(--sfd-rows), var(--sfd-row));
  }
  .stack-memory-grid { border: 2px solid #e5e7eb; background: #050505; }
  .stack-memory-grid > span { border-bottom: 1px solid rgba(255,255,255,.72); }
  .stack-memory-grid > span:last-child { border-bottom: 0; }

  .stack-memory-blocks {
    position: absolute;
    inset: 0;
    z-index: 2;
    grid-template-columns: 1fr;
    pointer-events: none;
  }
  .stack-memory-block {
    grid-column: 1;
    grid-row: var(--start) / span var(--span);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #f8fafc;
    color: #fff;
    font-size: .88rem;
    font-weight: 800;
    text-shadow: 0 1px 2px rgba(0,0,0,.45);
    animation: stackFrameBlockIn 180ms ease-out;
  }
  .stack-memory-block small {
    position: absolute;
    left: .22rem;
    bottom: .06rem;
    padding: 0 .16rem;
    border-radius: .2rem;
    background: rgba(0,0,0,.28);
    font-size: .46rem;
    font-weight: 700;
    opacity: .92;
  }

  .stack-memory-origin {
    position: absolute;
    right: calc(100% + .5rem);
    top: -.95rem;
    display: flex;
    align-items: center;
    gap: .28rem;
    color: #f8fafc;
    font-size: .68rem;
    white-space: nowrap;
  }
  .stack-memory-origin b { color: #fbbf24; font-size: 1rem; }

  .stack-memory-sp {
    position: absolute;
    right: calc(100% + .48rem);
    top: -.48rem;
    z-index: 4;
    color: #ef4444;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: .76rem;
    font-weight: 900;
    white-space: nowrap;
    transition: top 220ms ease;
  }

  .stack-memory-overflow {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2.8rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    border: 1px dashed #ef4444;
    border-radius: .42rem;
    color: #fecaca;
    background: rgba(127,29,29,.42);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 160ms ease, transform 160ms ease;
  }
  .stack-memory-overflow[data-active="true"] { opacity: 1; transform: translateY(0); animation: stackFrameOverflowPulse 600ms ease-in-out infinite alternate; }
  .stack-memory-overflow span { color: #fca5a5; font-size: .58rem; }

  .stack-frame-column {
    position: relative;
    width: 150px;
    height: calc(var(--sfd-rows) * var(--sfd-row));
  }
  .stack-frame-bracket {
    position: absolute;
    left: 4px;
    top: calc((var(--start) - 1) * var(--sfd-row));
    width: 22px;
    height: calc(var(--span) * var(--sfd-row));
    border-left: 3px solid var(--frame-color);
  }
  .stack-frame-bracket::before,
  .stack-frame-bracket::after {
    content: "";
    position: absolute;
    left: -3px;
    width: 14px;
    border-top: 3px solid var(--frame-color);
  }
  .stack-frame-bracket::before { top: 0; }
  .stack-frame-bracket::after { bottom: 0; }
  .stack-frame-bracket span {
    position: absolute;
    left: 20px;
    top: 50%;
    transform: translateY(-50%);
    display: block;
    width: 118px;
    padding: .28rem .38rem;
    border: 1px solid color-mix(in srgb, var(--frame-color) 55%, transparent);
    border-radius: .42rem;
    color: var(--frame-color);
    background: #0b1020;
    font-size: .64rem;
    font-weight: 800;
    line-height: 1.25;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .stack-frame-demo__note { margin-top: .7rem; color: var(--sfd-muted); font-size: .68rem; line-height: 1.55; }

  @keyframes stackFrameBlockIn { from { opacity: .25; transform: translateY(-5px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes stackFrameOverflowPulse { from { box-shadow: 0 0 0 rgba(239,68,68,0); } to { box-shadow: 0 0 28px rgba(239,68,68,.55); } }

  @media (max-width: 980px) {
    .stack-frame-demo__workspace { grid-template-columns: 1fr; }
    .stack-frame-demo__summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 620px) {
    .stack-frame-demo__header,
    .stack-frame-demo__memory-title { flex-direction: column; align-items: flex-start; }
    .stack-frame-demo__summary { grid-template-columns: 1fr; }
    .stack-frame-demo__counter { width: 100%; margin-left: 0; }
    .stack-frame-demo__workspace { padding: .7rem; }
  }
</style>

<script>
  type Panel = "main" | "helper" | "recursive";
  type LineState = "active" | "call" | "done";
  type Highlight = { panel: Panel; line: number; state: LineState };
  type FrameKind = "main" | "helper" | "recursive";
  type StackBlock = {
    key: string;
    label: string;
    value: string;
    size: number;
    frame: FrameKind;
    color: string;
  };
  type Step = {
    title: string;
    activeFrame: string;
    explanation: string;
    highlights: Highlight[];
    blocks: StackBlock[];
  };

  function initStackFrameDemo(root: HTMLElement): void {
    if (root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";

    const capacity = 24;
    const origin = 0x20001000;

    const map: Record<string, StackBlock> = {
      a:   { key: "a",   label: "a : uint8_t · 1B",  value: "12",   size: 1, frame: "main",   color: "#dc2626" },
      b:   { key: "b",   label: "b : uint16_t · 2B", value: "100",  size: 2, frame: "main",   color: "#059669" },
      c:   { key: "c",   label: "c : uint16_t · 2B", value: "112",  size: 2, frame: "main",   color: "#f97316" },
      d:   { key: "d",   label: "d : uint32_t · 4B", value: "4000", size: 4, frame: "main",   color: "#2563eb" },
      e:   { key: "e",   label: "e : uint8_t · 1B",  value: "240",  size: 1, frame: "main",   color: "#7c3aed" },
      f:   { key: "f",   label: "f : uint32_t · 4B", value: "9",    size: 4, frame: "main",   color: "#ca8a04" },
      g:   { key: "g",   label: "g : uint16_t · 2B", value: "10",   size: 2, frame: "main",   color: "#0284c7" },
      ret: { key: "ret", label: "RET · 返回地址 · 4B", value: "RET",  size: 4, frame: "helper", color: "#9333ea" },
      ha:  { key: "ha",  label: "a : uint16_t · 2B", value: "100",  size: 2, frame: "helper", color: "#0ea5e9" },
      hb:  { key: "hb",  label: "b : uint8_t · 1B",  value: "30",   size: 1, frame: "helper", color: "#1e3a8a" },
    };

    const take = (...keys: string[]): StackBlock[] => keys.map((key) => ({ ...map[key] }));

    const steps: Step[] = [
      {
        title: "进入 main()",
        activeFrame: "main",
        explanation: "SP 初始位于 0x20001000。下面每个小格代表 1 Byte，栈向低地址方向增长。",
        highlights: [{ panel: "main", line: 0, state: "active" }],
        blocks: [],
      },
      {
        title: "a 入栈：1 Byte",
        activeFrame: "main",
        explanation: "uint8_t a = 12 占 1 Byte，因此只填充 1 个字节格。",
        highlights: [{ panel: "main", line: 2, state: "active" }],
        blocks: take("a"),
      },
      {
        title: "b 入栈：2 Byte",
        activeFrame: "main",
        explanation: "uint16_t b = 100 占 2 Byte，所以变量块连续跨越 2 个字节格。",
        highlights: [{ panel: "main", line: 3, state: "active" }],
        blocks: take("a", "b"),
      },
      {
        title: "c 入栈：2 Byte",
        activeFrame: "main",
        explanation: "c = a + b 得到 112，c 是 uint16_t，同样占 2 Byte。",
        highlights: [{ panel: "main", line: 4, state: "active" }],
        blocks: take("a", "b", "c"),
      },
      {
        title: "d 入栈：4 Byte",
        activeFrame: "main",
        explanation: "uint32_t d = 4000 占 4 Byte，因此能明显看到变量块高度是 uint8_t 的 4 倍。",
        highlights: [{ panel: "main", line: 5, state: "active" }],
        blocks: take("a", "b", "c", "d"),
      },
      {
        title: "e 入栈：1 Byte",
        activeFrame: "main",
        explanation: "uint8_t e = 240 只占 1 Byte。",
        highlights: [{ panel: "main", line: 6, state: "active" }],
        blocks: take("a", "b", "c", "d", "e"),
      },
      {
        title: "f 入栈：4 Byte",
        activeFrame: "main",
        explanation: "uint32_t f = 9 占 4 Byte。此时 main 的教学栈帧共占 14 Byte。",
        highlights: [{ panel: "main", line: 7, state: "active" }],
        blocks: take("a", "b", "c", "d", "e", "f"),
      },
      {
        title: "CALL：压入 4 Byte 返回地址",
        activeFrame: "do_nothing",
        explanation: "执行 do_nothing() 时，先用 4 Byte 的 RET 表示 32 位返回地址。它和随后创建的局部变量一起归入本次函数调用的栈帧。",
        highlights: [{ panel: "main", line: 8, state: "call" }],
        blocks: take("a", "b", "c", "d", "e", "f", "ret"),
      },
      {
        title: "do_nothing.a 入栈：2 Byte",
        activeFrame: "do_nothing",
        explanation: "进入 do_nothing() 后，uint16_t a = 100 占 2 Byte。紫色括号完整标出本次函数调用的栈帧。",
        highlights: [
          { panel: "main", line: 8, state: "call" },
          { panel: "helper", line: 2, state: "active" },
        ],
        blocks: take("a", "b", "c", "d", "e", "f", "ret", "ha"),
      },
      {
        title: "do_nothing.b 入栈：1 Byte",
        activeFrame: "do_nothing",
        explanation: "uint8_t b = 30 再占 1 Byte。do_nothing 的教学栈帧此时为 RET 4B + a 2B + b 1B = 7 Byte。",
        highlights: [
          { panel: "main", line: 8, state: "call" },
          { panel: "helper", line: 3, state: "active" },
        ],
        blocks: take("a", "b", "c", "d", "e", "f", "ret", "ha", "hb"),
      },
      {
        title: "函数返回：释放整个 do_nothing 栈帧",
        activeFrame: "main",
        explanation: "do_nothing() 返回后，RET 和函数局部变量整体弹出，SP 从 21 Byte 已用位置恢复到 main 的 14 Byte 位置。",
        highlights: [{ panel: "main", line: 9, state: "active" }],
        blocks: take("a", "b", "c", "d", "e", "f"),
      },
      {
        title: "g 入栈：2 Byte",
        activeFrame: "main",
        explanation: "uint16_t g = 10 占 2 Byte，main 教学栈帧扩展为 16 Byte。",
        highlights: [{ panel: "main", line: 9, state: "active" }],
        blocks: take("a", "b", "c", "d", "e", "f", "g"),
      },
      {
        title: "再次调用 do_nothing()",
        activeFrame: "do_nothing",
        explanation: "第二次调用会重新压入 RET，并重新创建 do_nothing 的局部变量。最大占用为 16B + 7B = 23B，仍未超过 24B 演示边界。",
        highlights: [
          { panel: "main", line: 10, state: "call" },
          { panel: "helper", line: 3, state: "active" },
        ],
        blocks: take("a", "b", "c", "d", "e", "f", "g", "ret", "ha", "hb"),
      },
      {
        title: "执行结束",
        activeFrame: "main",
        explanation: "第二次函数返回后，do_nothing 栈帧再次整体释放，只留下 main 的局部变量。",
        highlights: [{ panel: "main", line: 11, state: "active" }],
        blocks: take("a", "b", "c", "d", "e", "f", "g"),
      },
    ];

    const q = <T extends Element>(selector: string): T | null => root.querySelector<T>(selector);
    const stepIndexEl = q<HTMLElement>("[data-step-index]");
    const stepTotalEl = q<HTMLElement>("[data-step-total]");
    const stepTitleEl = q<HTMLElement>("[data-step-title]");
    const activeFrameEl = q<HTMLElement>("[data-active-frame]");
    const usedEl = q<HTMLElement>("[data-used-space]");
    const spValueEl = q<HTMLElement>("[data-sp-value]");
    const explanationEl = q<HTMLElement>("[data-explanation]");
    const blocksRoot = q<HTMLElement>("[data-blocks]");
    const bracketsRoot = q<HTMLElement>("[data-brackets]");
    const spMarker = q<HTMLElement>("[data-sp-marker]");
    const overflowBanner = q<HTMLElement>("[data-overflow-banner]");
    const normalCode = q<HTMLElement>("[data-normal-code]");
    const recursivePanel = q<HTMLElement>("[data-recursive-code]");
    const prevBtn = q<HTMLButtonElement>('[data-action="prev"]');
    const nextBtn = q<HTMLButtonElement>('[data-action="next"]');
    const playBtn = q<HTMLButtonElement>('[data-action="play"]');
    const overflowBtn = q<HTMLButtonElement>('[data-action="overflow"]');
    const resetBtn = q<HTMLButtonElement>('[data-action="reset"]');
    const codeLines = Array.from(root.querySelectorAll<HTMLElement>("[data-panel][data-line]"));

    if (!stepIndexEl || !stepTotalEl || !stepTitleEl || !activeFrameEl || !usedEl || !spValueEl || !explanationEl || !blocksRoot || !bracketsRoot || !spMarker || !overflowBanner || !normalCode || !recursivePanel || !prevBtn || !nextBtn || !playBtn || !overflowBtn || !resetBtn) return;

    let currentStep = 0;
    let timer = 0;
    let recursiveMode = false;
    let recursionDepth = 0;

    const stopTimer = (): void => {
      if (timer) window.clearInterval(timer);
      timer = 0;
      playBtn.textContent = "自动播放";
    };

    const clearHighlights = (): void => {
      codeLines.forEach((line) => delete line.dataset.state);
    };

    const addBracket = (start: number, span: number, label: string, color: string): void => {
      const bracket = document.createElement("div");
      bracket.className = "stack-frame-bracket";
      bracket.style.setProperty("--start", String(start + 1));
      bracket.style.setProperty("--span", String(span));
      bracket.style.setProperty("--frame-color", color);
      const text = document.createElement("span");
      text.textContent = label;
      bracket.append(text);
      bracketsRoot.append(bracket);
    };

    const renderBlocks = (items: StackBlock[]): number => {
      blocksRoot.replaceChildren();
      bracketsRoot.replaceChildren();

      let offset = 0;
      const ranges: { frame: FrameKind; start: number; span: number }[] = [];
      let currentFrame: FrameKind | null = null;
      let frameStart = 0;
      let frameSpan = 0;

      for (const item of items) {
        const block = document.createElement("div");
        block.className = "stack-memory-block";
        block.style.setProperty("--start", String(offset + 1));
        block.style.setProperty("--span", String(item.size));
        block.style.background = item.color;
        block.title = `${item.label}；值 = ${item.value}`;

        const value = document.createElement("span");
        value.textContent = item.value;
        const label = document.createElement("small");
        label.textContent = item.label;
        block.append(value, label);
        blocksRoot.append(block);

        if (currentFrame === null) {
          currentFrame = item.frame;
          frameStart = offset;
          frameSpan = item.size;
        } else if (currentFrame === item.frame) {
          frameSpan += item.size;
        } else {
          ranges.push({ frame: currentFrame, start: frameStart, span: frameSpan });
          currentFrame = item.frame;
          frameStart = offset;
          frameSpan = item.size;
        }
        offset += item.size;
      }

      if (currentFrame !== null) {
        ranges.push({ frame: currentFrame, start: frameStart, span: frameSpan });
      }

      for (const range of ranges) {
        if (range.frame === "main") addBracket(range.start, range.span, `main 栈帧 · ${range.span}B`, "#38bdf8");
        if (range.frame === "helper") addBracket(range.start, range.span, `do_nothing 栈帧 · ${range.span}B`, "#a855f7");
        if (range.frame === "recursive") addBracket(range.start, range.span, `递归活动栈帧 · ${range.span}B`, "#ef4444");
      }

      return offset;
    };

    const setSp = (used: number): void => {
      usedEl.textContent = `${used} / ${capacity} B`;
      spValueEl.textContent = `0x${(origin - used).toString(16).toUpperCase()}`;
      spMarker.style.top = `calc(${Math.min(used, capacity)} * var(--sfd-row) - .46rem)`;
    };

    const renderStep = (): void => {
      recursiveMode = false;
      normalCode.hidden = false;
      recursivePanel.hidden = true;
      overflowBanner.dataset.active = "false";

      const step = steps[currentStep];
      stepIndexEl.textContent = String(currentStep + 1);
      stepTotalEl.textContent = String(steps.length);
      stepTitleEl.textContent = step.title;
      activeFrameEl.textContent = step.activeFrame;
      explanationEl.textContent = step.explanation;
      clearHighlights();

      for (const highlight of step.highlights) {
        const line = q<HTMLElement>(`[data-panel="${highlight.panel}"][data-line="${highlight.line}"]`);
        if (line) line.dataset.state = highlight.state;
      }

      const used = renderBlocks(step.blocks);
      setSp(used);
      prevBtn.disabled = currentStep === 0;
      nextBtn.disabled = currentStep === steps.length - 1;
    };

    const renderRecursive = (): void => {
      recursiveMode = true;
      normalCode.hidden = true;
      recursivePanel.hidden = false;
      clearHighlights();
      const callLine = q<HTMLElement>('[data-panel="recursive"][data-line="3"]');
      if (callLine) callLine.dataset.state = "active";

      const recursiveItems: StackBlock[] = [];
      let requestedBytes = 0;
      for (let depth = 1; depth <= recursionDepth; depth += 1) {
        recursiveItems.push(
          { key: `rr${depth}`, label: `RET #${depth} · 4B`, value: "RET", size: 4, frame: "recursive", color: "#991b1b" },
          { key: `rb${depth}`, label: `buf[4] #${depth} · 4B`, value: `buf ${depth}`, size: 4, frame: "recursive", color: "#dc2626" },
        );
        requestedBytes += 8;
      }

      const visibleItems: StackBlock[] = [];
      let visibleBytes = 0;
      for (const item of recursiveItems) {
        if (visibleBytes + item.size > capacity) break;
        visibleItems.push(item);
        visibleBytes += item.size;
      }

      renderBlocks(visibleItems);
      setSp(visibleBytes);
      stepIndexEl.textContent = String(recursionDepth);
      stepTotalEl.textContent = "∞";
      activeFrameEl.textContent = `recurse(${recursionDepth})`;
      prevBtn.disabled = true;
      nextBtn.disabled = true;

      if (requestedBytes > capacity) {
        overflowBanner.dataset.active = "true";
        stepTitleEl.textContent = "Stack Overflow";
        explanationEl.textContent = `第 ${recursionDepth} 层递归还需要新的 RET 4B + buf[4] 4B，但总需求达到 ${requestedBytes}B，超过 24B 演示栈容量，因此发生 Stack Overflow。`;
        stopTimer();
      } else {
        overflowBanner.dataset.active = "false";
        stepTitleEl.textContent = `递归深度 ${recursionDepth}`;
        explanationEl.textContent = `每层递归在教学模型中保留返回地址 4B 和局部数组 buf[4] 4B，因此每深入一层就增加 8B 栈占用。`;
      }
    };

    prevBtn.addEventListener("click", () => {
      stopTimer();
      if (recursiveMode) return;
      currentStep = Math.max(0, currentStep - 1);
      renderStep();
    });

    nextBtn.addEventListener("click", () => {
      stopTimer();
      if (recursiveMode) return;
      currentStep = Math.min(steps.length - 1, currentStep + 1);
      renderStep();
    });

    playBtn.addEventListener("click", () => {
      if (timer) {
        stopTimer();
        return;
      }
      if (recursiveMode) return;
      playBtn.textContent = "暂停";
      timer = window.setInterval(() => {
        if (currentStep >= steps.length - 1) {
          stopTimer();
          return;
        }
        currentStep += 1;
        renderStep();
      }, 1100);
    });

    overflowBtn.addEventListener("click", () => {
      stopTimer();
      recursionDepth = 1;
      renderRecursive();
      timer = window.setInterval(() => {
        recursionDepth += 1;
        renderRecursive();
      }, 720);
    });

    resetBtn.addEventListener("click", () => {
      stopTimer();
      currentStep = 0;
      recursionDepth = 0;
      recursiveMode = false;
      renderStep();
    });

    document.addEventListener("astro:before-swap", stopTimer, { once: true });
    renderStep();
  }

  document.querySelectorAll<HTMLElement>("[data-stack-frame-demo]").forEach(initStackFrameDemo);
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>("[data-stack-frame-demo]").forEach(initStackFrameDemo);
  });
</script>
