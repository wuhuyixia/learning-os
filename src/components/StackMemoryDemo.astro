---
const initialCode = `void main(void)
{
    int a = 10;
}`;
---

<section class="stack-demo not-prose" data-stack-demo>
  <div class="stack-demo__header">
    <div>
      <h3>栈存储与溢出演示</h3>
      <p>观察局部变量、函数调用和递归如何占用栈空间。</p>
    </div>
    <span class="stack-demo__status" data-status>运行正常</span>
  </div>

  <div class="stack-demo__workspace">
    <div class="stack-demo__memory">
      <span class="stack-demo__address stack-demo__address--high">高地址 0x20001000</span>
      <div class="stack-demo__slots" data-slots></div>
      <div class="stack-demo__sp" data-sp>SP →</div>
      <span class="stack-demo__address stack-demo__address--low">低地址</span>
      <span class="stack-demo__direction">栈向低地址增长 ↓</span>
      <div class="stack-demo__overflow" data-overflow>
        <strong>STACK OVERFLOW</strong>
        <span>栈空间耗尽</span>
      </div>
    </div>

    <div class="stack-demo__panel">
      <div class="stack-demo__buttons">
        <button type="button" data-action="push">压入局部变量</button>
        <button type="button" data-action="call">调用函数</button>
        <button type="button" data-action="pop">函数返回 / 出栈</button>
        <button type="button" data-action="recurse">递归直到溢出</button>
        <button type="button" data-action="reset">重置</button>
      </div>

      <div class="stack-demo__info">
        <div><span>栈容量</span><strong>8 单元</strong></div>
        <div><span>已使用</span><strong data-used>0 / 8</strong></div>
        <div><span>剩余空间</span><strong data-free>8</strong></div>
        <div><span>当前 SP</span><strong data-sp-value>0x20001000</strong></div>
      </div>

      <div class="stack-demo__code">
        <div class="stack-demo__code-title">示意代码</div>
        <pre><code data-code>{initialCode}</code></pre>
      </div>

      <div class="stack-demo__log" aria-live="polite" data-log>
        点击按钮观察栈帧变化。
      </div>
    </div>
  </div>
</section>

<style>
  .stack-demo {
    --sd-border: color-mix(in srgb, currentColor 16%, transparent);
    --sd-muted: color-mix(in srgb, currentColor 58%, transparent);
    margin: 1.5rem 0 2rem;
    padding: 1rem;
    border: 1px solid var(--sd-border);
    border-radius: 1rem;
    background: color-mix(in srgb, currentColor 2.5%, transparent);
  }

  .stack-demo__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .stack-demo__header h3 { margin: 0; font-size: 1.05rem; }
  .stack-demo__header p { margin: 0.25rem 0 0; color: var(--sd-muted); font-size: 0.86rem; }

  .stack-demo__status {
    flex: 0 0 auto;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    color: #15803d;
    background: rgba(22, 163, 74, 0.14);
    font-size: 0.76rem;
    font-weight: 700;
  }

  .stack-demo__workspace {
    display: grid;
    grid-template-columns: minmax(260px, 0.85fr) minmax(320px, 1.15fr);
    gap: 1rem;
  }

  .stack-demo__memory {
    position: relative;
    min-height: 500px;
    padding: 3.2rem 3rem 4.2rem 4.4rem;
    overflow: hidden;
    border-radius: 0.85rem;
    color: #e5e7eb;
    background: #05070a;
  }

  .stack-demo__slots {
    display: grid;
    grid-template-rows: repeat(8, 1fr);
    height: 360px;
    overflow: hidden;
    border: 2px solid #64748b;
    border-radius: 0.45rem;
    background: #0f172a;
  }

  .stack-demo__slot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0 0.7rem;
    border-bottom: 1px solid #334155;
    color: #94a3b8;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.75rem;
  }

  .stack-demo__slot:last-child { border-bottom: 0; }
  .stack-demo__slot[data-kind="local"] { color: #fff; background: linear-gradient(90deg, #1d4ed8, #2563eb); }
  .stack-demo__slot[data-kind="frame"] { color: #fff; background: linear-gradient(90deg, #6d28d9, #9333ea); }
  .stack-demo__slot[data-kind="recursive"] { color: #fff; background: linear-gradient(90deg, #be123c, #e11d48); }

  .stack-demo__slot-address { opacity: 0.72; font-size: 0.66rem; }

  .stack-demo__sp {
    position: absolute;
    left: 0.7rem;
    top: 3.2rem;
    color: #fbbf24;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 800;
    transition: top 240ms ease;
  }

  .stack-demo__address {
    position: absolute;
    right: 0.8rem;
    color: #94a3b8;
    font-size: 0.68rem;
  }

  .stack-demo__address--high { top: 1rem; }
  .stack-demo__address--low { bottom: 1rem; }

  .stack-demo__direction {
    position: absolute;
    left: 0.6rem;
    bottom: 1rem;
    color: #94a3b8;
    font-size: 0.68rem;
  }

  .stack-demo__overflow {
    position: absolute;
    left: 4.4rem;
    right: 3rem;
    bottom: 0.7rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 36px;
    border: 1px dashed #ef4444;
    border-radius: 0.45rem;
    color: #fecaca;
    background: rgba(127, 29, 29, 0.28);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .stack-demo__overflow[data-active="true"] {
    opacity: 1;
    transform: translateY(0);
    animation: stack-overflow 600ms ease-in-out infinite alternate;
  }

  .stack-demo__overflow span { color: #fca5a5; font-size: 0.72rem; }
  .stack-demo__panel { display: flex; flex-direction: column; gap: 0.9rem; }

  .stack-demo__buttons {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem;
  }

  .stack-demo__buttons button {
    padding: 0.58rem 0.65rem;
    border: 1px solid var(--sd-border);
    border-radius: 0.65rem;
    color: inherit;
    background: transparent;
    cursor: pointer;
    font-size: 0.82rem;
  }

  .stack-demo__buttons button:hover { background: color-mix(in srgb, currentColor 7%, transparent); }
  .stack-demo__buttons button[data-action="recurse"] { border-color: rgba(225, 29, 72, 0.45); }

  .stack-demo__info {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem;
  }

  .stack-demo__info div {
    padding: 0.65rem;
    border: 1px solid var(--sd-border);
    border-radius: 0.65rem;
  }

  .stack-demo__info span { display: block; color: var(--sd-muted); font-size: 0.72rem; }
  .stack-demo__info strong { display: block; margin-top: 0.2rem; font-size: 0.9rem; }

  .stack-demo__code {
    overflow: hidden;
    border: 1px solid var(--sd-border);
    border-radius: 0.7rem;
    color: #dbeafe;
    background: #0b1020;
  }

  .stack-demo__code-title {
    padding: 0.45rem 0.65rem;
    border-bottom: 1px solid rgba(148, 163, 184, 0.2);
    color: #94a3b8;
    font-size: 0.7rem;
  }

  .stack-demo__code pre {
    margin: 0;
    padding: 0.75rem;
    overflow-x: auto;
    color: inherit;
    background: transparent;
    font-size: 0.75rem;
    line-height: 1.55;
  }

  .stack-demo__log {
    min-height: 42px;
    padding: 0.65rem 0.75rem;
    border-left: 3px solid #3b82f6;
    border-radius: 0.35rem;
    color: var(--sd-muted);
    background: color-mix(in srgb, currentColor 3%, transparent);
    font-size: 0.78rem;
  }

  @keyframes stack-overflow {
    from { box-shadow: 0 0 0 rgba(239, 68, 68, 0); }
    to { box-shadow: 0 0 24px rgba(239, 68, 68, 0.48); }
  }

  @media (max-width: 760px) {
    .stack-demo__workspace { grid-template-columns: 1fr; }
  }

  @media (max-width: 520px) {
    .stack-demo__header { flex-direction: column; }
    .stack-demo__buttons,
    .stack-demo__info { grid-template-columns: 1fr; }
  }
</style>

<script>
  type CellKind = "local" | "frame" | "recursive";
  type StackCell = { label: string; kind: CellKind };

  function initStackDemo(root: HTMLElement): void {
    if (root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";

    const capacity = 8;
    const baseAddress = 0x20001000;
    const bytesPerCell = 16;
    const cells: StackCell[] = [];
    let variableId = 0;
    let functionId = 0;
    let timer = 0;
    let overflowed = false;

    const slotsRoot = root.querySelector<HTMLElement>("[data-slots]");
    const spMarker = root.querySelector<HTMLElement>("[data-sp]");
    const status = root.querySelector<HTMLElement>("[data-status]");
    const used = root.querySelector<HTMLElement>("[data-used]");
    const free = root.querySelector<HTMLElement>("[data-free]");
    const spValue = root.querySelector<HTMLElement>("[data-sp-value]");
    const log = root.querySelector<HTMLElement>("[data-log]");
    const code = root.querySelector<HTMLElement>("[data-code]");
    const overflow = root.querySelector<HTMLElement>("[data-overflow]");

    if (!slotsRoot || !spMarker || !status || !used || !free || !spValue || !log || !code || !overflow) return;

    for (let index = 0; index < capacity; index += 1) {
      const slot = document.createElement("div");
      slot.className = "stack-demo__slot";
      slot.dataset.slot = String(index);
      slotsRoot.append(slot);
    }

    const stopRecursion = (): void => {
      if (timer) window.clearInterval(timer);
      timer = 0;
    };

    const setCode = (value: string): void => {
      code.textContent = value;
    };

    const setOverflow = (message: string): void => {
      overflowed = true;
      stopRecursion();
      overflow.dataset.active = "true";
      status.textContent = "栈溢出";
      status.style.color = "#b91c1c";
      status.style.background = "rgba(239,68,68,0.14)";
      log.textContent = message;
      setCode("void recurse(void)\n{\n    char buf[16];\n    recurse();\n}\n\n// Stack Overflow");
    };

    const render = (): void => {
      const slotElements = Array.from(slotsRoot.querySelectorAll<HTMLElement>("[data-slot]"));
      slotElements.forEach((slot, index) => {
        const cell = cells[index];
        slot.replaceChildren();
        if (cell) slot.dataset.kind = cell.kind;
        else delete slot.dataset.kind;

        const label = document.createElement("span");
        label.textContent = cell?.label ?? "空闲";
        const address = document.createElement("span");
        address.className = "stack-demo__slot-address";
        address.textContent = `0x${(baseAddress - index * bytesPerCell).toString(16).toUpperCase()}`;
        slot.append(label, address);
      });

      const count = cells.length;
      used.textContent = `${count} / ${capacity}`;
      free.textContent = String(capacity - count);
      spValue.textContent = `0x${(baseAddress - count * bytesPerCell).toString(16).toUpperCase()}`;
      spMarker.style.top = `${51 + (Math.min(count, capacity) * 360) / capacity}px`;

      if (!overflowed) {
        const tight = count >= 6;
        status.textContent = tight ? "栈空间紧张" : "运行正常";
        status.style.color = tight ? "#a16207" : "#15803d";
        status.style.background = tight ? "rgba(234,179,8,0.16)" : "rgba(22,163,74,0.14)";
      }
    };

    const pushCell = (cell: StackCell): boolean => {
      if (cells.length >= capacity) {
        setOverflow("继续压栈将越过栈边界，发生 Stack Overflow。");
        return false;
      }
      cells.push(cell);
      render();
      return true;
    };

    const clearOverflow = (): void => {
      overflowed = false;
      overflow.dataset.active = "false";
    };

    root.querySelector('[data-action="push"]')?.addEventListener("click", () => {
      stopRecursion();
      clearOverflow();
      variableId += 1;
      if (pushCell({ label: `局部变量 v${variableId}`, kind: "local" })) {
        log.textContent = `创建局部变量 v${variableId}，SP 向低地址移动 ${bytesPerCell} 字节。`;
        setCode(`void task(void)\n{\n    int v${variableId} = ${variableId * 10};\n}`);
      }
    });

    root.querySelector('[data-action="call"]')?.addEventListener("click", () => {
      stopRecursion();
      clearOverflow();
      functionId += 1;
      if (cells.length + 2 > capacity) {
        setOverflow(`func${functionId} 需要两个栈单元，但剩余空间不足。`);
        return;
      }
      pushCell({ label: `func${functionId}: 返回地址`, kind: "frame" });
      pushCell({ label: `func${functionId}: 局部变量`, kind: "frame" });
      log.textContent = `调用 func${functionId}，创建新的函数栈帧。`;
      setCode(`void func${functionId}(void)\n{\n    int temp = ${functionId};\n}\n\nfunc${functionId}();`);
    });

    root.querySelector('[data-action="pop"]')?.addEventListener("click", () => {
      stopRecursion();
      if (cells.length === 0) {
        log.textContent = "栈已经为空。";
        return;
      }
      const removed = cells.pop();
      clearOverflow();
      log.textContent = `${removed?.label ?? "栈单元"} 已出栈，SP 向高地址恢复。`;
      setCode("// 函数返回或作用域结束\n// 对应栈空间自动释放");
      render();
    });

    root.querySelector('[data-action="recurse"]')?.addEventListener("click", () => {
      if (timer) return;
      clearOverflow();
      setCode("void recurse(void)\n{\n    char buf[16];\n    recurse();\n}");
      log.textContent = "开始递归，每次调用都会增加一个栈帧……";
      timer = window.setInterval(() => {
        const depth = cells.filter((cell) => cell.kind === "recursive").length + 1;
        if (pushCell({ label: `recurse(${depth}) 栈帧`, kind: "recursive" })) {
          log.textContent = `递归深度 ${depth}，栈继续向低地址增长。`;
        }
      }, 430);
    });

    root.querySelector('[data-action="reset"]')?.addEventListener("click", () => {
      stopRecursion();
      cells.length = 0;
      variableId = 0;
      functionId = 0;
      clearOverflow();
      log.textContent = "栈已重置。点击按钮观察栈帧变化。";
      setCode("void main(void)\n{\n    int a = 10;\n}");
      render();
    });

    document.addEventListener("astro:before-swap", stopRecursion, { once: true });
    render();
  }

  document.querySelectorAll<HTMLElement>("[data-stack-demo]").forEach(initStackDemo);
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>("[data-stack-demo]").forEach(initStackDemo);
  });
</script>
